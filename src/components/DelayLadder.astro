---
/**
 * Beyond Earth: one-way delays from the same room to Mars, and a clinic offline, on an axis
 * marked "not to scale", under the bracket "One rule for the whole range".
 *
 * One row on wide screens; a column under 640 px, with the axis running down. The figures stay
 * as the copy gives them (about 1.3 seconds to the Moon, about 4 to 24 minutes to Mars). Words
 * come from the page's frontmatter; colour only from the `--p-*` tokens, with the primary for
 * the highlighted step. `.bracket` is what the motion stage stretches.
 */
interface Props {
  title: string;
  label: string;
  axis: string;
  axisNarrow: string;
  rule: string;
  steps: readonly { place: string; delay: readonly string[]; highlight?: boolean }[];
}
const { title, label, axis, axisNarrow, rule, steps } = Astro.props;

// Wide: five boxes in a row.
const W = { box: 140, gap: 20, top: 0, height: 92 };
const wideWidth = steps.length * W.box + (steps.length - 1) * W.gap;
const axisY = W.top + W.height + 32;

// Narrow: a column, axis down the left.
const N = { left: 30, width: 250, height: 58, gap: 12 };
const columnHeight = steps.length * N.height + (steps.length - 1) * N.gap;
---

<figure class="illustration mx-auto max-w-4xl">
  <p class="text-ink text-center text-lg font-bold text-balance">{title}</p>

  <!-- Wide -->
  <svg
    class="mt-6 hidden h-auto w-full sm:block"
    viewBox={`-2 -2 ${wideWidth + 4} ${axisY + 70}`}
    role="img"
    aria-label={label}
  >
    {
      steps.map(({ place, delay, highlight }, i) => {
        const x = i * (W.box + W.gap);
        return (
          <>
            <rect
              x={x}
              y={W.top}
              width={W.box}
              height={W.height}
              rx="12"
              class:list={[
                highlight ? 'fill-primary-tint stroke-primary' : 'fill-surface stroke-line-strong',
              ]}
              stroke-width={highlight ? 2.5 : 1.5}
            />
            <text text-anchor="middle">
              <tspan
                x={x + W.box / 2}
                y={W.top + 32}
                class="fill-ink"
                font-size="15"
                font-weight="700"
              >
                {place}
              </tspan>
              {delay.map((line, j) => (
                <tspan
                  x={x + W.box / 2}
                  y={W.top + 54 + j * 17}
                  class="fill-ink-muted"
                  font-size="14"
                >
                  {line}
                </tspan>
              ))}
            </text>
          </>
        );
      })
    }
    <path
      d={`M0 ${axisY}H${wideWidth - 2}M${wideWidth - 10} ${axisY - 6}l8 6-8 6`}
      class="stroke-line-strong"
      stroke-width="1.5"
      fill="none"></path>
    <text x="0" y={axisY + 24} class="fill-ink-muted" font-size="14">{axis}</text>
    <path
      class="bracket stroke-primary"
      d={`M1 ${axisY + 44}v10H${wideWidth - 1}v-10`}
      stroke-width="2"
      fill="none"></path>
  </svg>

  <!-- Narrow: a column, the axis running down -->
  <p class="text-ink-muted mt-6 text-center text-sm sm:hidden">{axisNarrow}</p>
  <svg
    class="mx-auto mt-3 h-auto w-full max-w-sm sm:hidden"
    viewBox={`-2 -2 284 ${columnHeight + 34}`}
    role="img"
    aria-label={label}
  >
    <path
      d={`M10 0V${columnHeight - 2}M4 ${columnHeight - 10}l6 8 6-8`}
      class="stroke-line-strong"
      stroke-width="1.5"
      fill="none"></path>
    {
      steps.map(({ place, delay, highlight }, i) => {
        const y = i * (N.height + N.gap);
        return (
          <>
            <rect
              x={N.left}
              y={y}
              width={N.width}
              height={N.height}
              rx="10"
              class:list={[
                highlight ? 'fill-primary-tint stroke-primary' : 'fill-surface stroke-line-strong',
              ]}
              stroke-width={highlight ? 2.5 : 1.5}
            />
            <text x={N.left + 14} y={y + 24} class="fill-ink" font-size="14" font-weight="700">
              {place}
            </text>
            <text x={N.left + 14} y={y + 44} class="fill-ink-muted" font-size="13">
              {delay.join(' ')}
            </text>
          </>
        );
      })
    }
    <path
      class="bracket stroke-primary"
      d={`M1 ${columnHeight + 18}v10H279v-10`}
      stroke-width="2"
      fill="none"></path>
  </svg>

  <figcaption class="text-ink mt-3 text-center text-sm font-semibold text-pretty sm:text-base">
    {rule}
  </figcaption>
</figure>
