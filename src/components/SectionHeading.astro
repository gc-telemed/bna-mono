---
interface Props {
  eyebrow?: string;
  title: string;
  /** Rendered in the accent colour on its own line, after the title. */
  accentTitle?: string;
  lede?: string;
  accentClass?: string;
  /** No longer used: the eyebrow is a plain caption since the v5.1 redesign. Kept so older
   * call sites still type-check. */
  chipClass?: string;
  align?: 'center' | 'left';
}

const {
  eyebrow,
  title,
  accentTitle,
  lede,
  accentClass = 'text-primary',
  align = 'center',
} = Astro.props;
---

<div class:list={['reveal', align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-2xl']}>
  {
    eyebrow && (
      <span class="text-ink-muted inline-block text-xs font-semibold tracking-[0.22em] uppercase">
        {eyebrow}
      </span>
    )
  }
  <h2
    class:list={[
      'text-ink text-3xl font-bold tracking-tight text-balance md:text-4xl md:leading-tight',
      eyebrow && 'mt-3',
    ]}
  >
    {title}
    {
      accentTitle && (
        <>
          {' '}
          <br class="hidden md:block" />
          <span class={accentClass}>{accentTitle}</span>
        </>
      )
    }
  </h2>
  {
    lede && (
      <p
        class:list={[
          'text-ink-muted mt-5 text-lg leading-relaxed text-pretty',
          align === 'center' && 'mx-auto max-w-2xl',
        ]}
      >
        {lede}
      </p>
    )
  }
</div>
