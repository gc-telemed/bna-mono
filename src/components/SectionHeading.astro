---
interface Props {
  eyebrow?: string;
  title: string;
  /** Rendered in the accent colour on its own line, after the title. */
  accentTitle?: string;
  lede?: string;
  accentClass?: string;
  chipClass?: string;
  align?: 'center' | 'left';
}

const {
  eyebrow,
  title,
  accentTitle,
  lede,
  accentClass = 'text-primary',
  chipClass = 'border-primary/30 bg-primary-tint text-ink',
  align = 'center',
} = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-2xl']}>
  {
    eyebrow && (
      <span
        class:list={['inline-block rounded-full border px-4 py-1 text-sm font-medium', chipClass]}
      >
        {eyebrow}
      </span>
    )
  }
  <h2
    class:list={[
      'text-ink text-3xl font-bold tracking-tight text-balance md:text-4xl md:leading-tight',
      eyebrow && 'mt-4',
    ]}
  >
    {title}
    {
      accentTitle && (
        <>
          {' '}
          <br class="hidden md:block" />
          <span class={accentClass}>{accentTitle}</span>
        </>
      )
    }
  </h2>
  {
    lede && (
      <p
        class:list={[
          'text-ink-muted mt-4 leading-relaxed text-pretty',
          align === 'center' && 'mx-auto max-w-2xl',
        ]}
      >
        {lede}
      </p>
    )
  }
</div>
