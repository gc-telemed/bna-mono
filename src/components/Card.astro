---
interface Props {
  emoji?: string;
  title: string;
  body: string;
  class?: string;
}
const { emoji, title, body, class: className } = Astro.props;
---

<div class:list={['border-line bg-surface rounded-2xl border p-6', className]}>
  {
    emoji && (
      <span class="text-3xl" aria-hidden="true">
        {emoji}
      </span>
    )
  }
  <p class:list={['text-ink font-semibold', emoji && 'mt-3']}>
    {title}
  </p>
  <p class="text-ink-muted mt-1.5 text-sm leading-relaxed">{body}</p>
</div>
