---
interface Props {
  emoji?: string;
  title: string;
  body: string;
  class?: string;
}
const { emoji, title, body, class: className } = Astro.props;
---

<div
  class:list={[
    'rounded-2xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900',
    className,
  ]}
>
  {
    emoji && (
      <span class="text-3xl" aria-hidden="true">
        {emoji}
      </span>
    )
  }
  <p class:list={['font-semibold text-neutral-900 dark:text-neutral-100', emoji && 'mt-3']}>
    {title}
  </p>
  <p class="mt-1.5 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">{body}</p>
</div>
