---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{/* Three peers, connected directly to each other — the P2P mark. */}
<span class:list={['inline-flex items-center gap-2', className]}>
  <svg
    viewBox="0 0 32 32"
    class="h-7 w-7 flex-shrink-0"
    fill="none"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path d="M16 7.5 7 24.5h18L16 7.5Z" stroke-width="1.75" class="text-brand-500/40"></path>
    <circle cx="16" cy="7.5" r="3.6" class="fill-brand-500 stroke-none"></circle>
    <circle cx="7" cy="24.5" r="3.6" class="fill-brand-600 stroke-none"></circle>
    <circle cx="25" cy="24.5" r="3.6" class="fill-brand-400 stroke-none"></circle>
  </svg>
  {/* The domain is the brand, so the wordmark is always lowercase. */}
  <span class="text-xl font-bold tracking-tight text-neutral-900 lowercase dark:text-white">
    cosys<span class="text-brand-600 dark:text-brand-400">.work</span>
  </span>
</span>
