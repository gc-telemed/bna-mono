---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{/*
  The cosys.work wordmark, from the brand's logo canvas: Nunito at 800, tracked in by 3%,
  one ink with an orange dot. Reversed on the two dark themes. The domain is the brand, so
  it is always lowercase, and it is text rather than an image so it stays sharp and theme-aware.
*/}
<span class:list={['cosys-wordmark', className]}>
  cosys<span class="cosys-dot">.</span>work
</span>

<style>
  .cosys-wordmark {
    font-family: 'Nunito Variable', 'Nunito', ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #12312c;
    white-space: nowrap;
  }
  .cosys-dot {
    color: #e8702a;
  }
  :global(:root[data-scheme='dark']) .cosys-wordmark {
    color: #f6f4ee;
  }
  :global(:root[data-scheme='dark']) .cosys-dot {
    color: #f08a4b;
  }
</style>
