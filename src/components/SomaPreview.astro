---
/**
 * A still preview of three SoMA screens: the composer, one post's journey, and the proof seal.
 *
 * In the spirit of AppPreview.astro, but static: no script, nothing to tap, nothing saved. It
 * paints with the site's `--p-*` tokens so the theme picker repaints it, and every screen is
 * labelled as a preview of the design. The layout follows the phone previews in the team deck;
 * the words are SoMA's own (the deck shows the earlier spelling).
 *
 * The persona name and the post are invented. needs_review: Nepali versions of these strings.
 */
interface Props {
  screen: 'composer' | 'journey' | 'proof';
  class?: string;
}
const { screen, class: className } = Astro.props;

const label = 'A preview of the design';

const persona = 'quiet-heron-41';

const composer = {
  title: 'New post',
  postingAs: 'Posting as',
  body: 'The river path is open again after the rains. Photos from this morning, and a map of the dry route.',
  attachments: ['2 photos', '1 map'],
  networksLabel: 'Post to',
  networks: ['Nostr', 'Mastodon', 'Bluesky', 'Share sheet'],
  action: 'Post everywhere',
  note: 'Signed on this phone before it goes anywhere.',
  caption: 'The composer',
};

const journey = {
  title: 'Where this post went',
  rows: [
    { network: 'Nostr', how: 'Straight to your 3 relays', state: 'Posted' },
    { network: 'Mastodon', how: 'Through your operator’s bridge', state: 'Posted' },
    { network: 'Bluesky', how: 'Through your operator’s bridge', state: 'Posted' },
    { network: 'Instagram', how: 'Share sheet, link kept private', state: 'Shared' },
  ],
  note: 'Replies from each network come back here.',
  caption: 'One post’s journey',
};

const proof = {
  title: 'Proof',
  seal: 'Timestamped',
  rows: [
    { term: 'Version', detail: '3 of 3' },
    { term: 'Signed by', detail: persona },
    { term: 'Timestamp', detail: 'OpenTimestamps, anchored in Bitcoin' },
    { term: 'Earlier versions', detail: '2, each signed' },
  ],
  note: 'No wallet and no coins. Anyone can check the seal.',
  caption: 'The proof seal',
};

const caption = { composer, journey, proof }[screen].caption;
const chip = 'border-line bg-surface-muted text-ink rounded-full border px-2.5 py-0.5 text-xs';
---

<figure class:list={['mx-auto w-full max-w-[18rem]', className]}>
  <div
    class="border-line-strong bg-surface-muted rounded-[2.25rem] border p-2 shadow-lg"
    data-preview-phone
  >
    <div
      class="bg-ground text-ink flex aspect-[9/17] flex-col overflow-hidden rounded-[1.75rem] text-sm"
    >
      <p class="text-ink-muted bg-surface border-line border-b px-4 py-1.5 text-center text-xs">
        {label}
      </p>
      {
        screen === 'composer' && (
          <div class="flex flex-1 flex-col p-4">
            <p class="text-ink text-base font-bold">{composer.title}</p>
            <p class="text-ink-muted mt-2 text-xs">
              {composer.postingAs} <span class="text-ink font-semibold">{persona}</span>
            </p>
            <p class="border-line bg-surface text-ink mt-3 rounded-xl border p-3 leading-relaxed">
              {composer.body}
            </p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {composer.attachments.map((item) => (
                <li class={chip}>{item}</li>
              ))}
            </ul>
            <p class="text-ink-muted mt-4 text-xs font-semibold tracking-wider uppercase">
              {composer.networksLabel}
            </p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {composer.networks.map((item) => (
                <li class="border-primary/30 bg-primary-tint text-ink rounded-full border px-2.5 py-0.5 text-xs">
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-4">
              <span class="bg-primary text-on-fill block rounded-xl py-2.5 text-center font-semibold">
                {composer.action}
              </span>
              <p class="text-ink-muted mt-2 text-center text-xs">{composer.note}</p>
            </div>
          </div>
        )
      }
      {
        screen === 'journey' && (
          <div class="flex flex-1 flex-col p-4">
            <p class="text-ink text-base font-bold">{journey.title}</p>
            <ol class="mt-3 grid gap-2">
              {journey.rows.map(({ network, how, state }) => (
                <li class="border-line bg-surface flex items-start gap-2.5 rounded-xl border p-2.5">
                  <span class="bg-primary mt-1.5 h-2 w-2 flex-shrink-0 rounded-full" />
                  <span class="flex-1">
                    <span class="text-ink block font-semibold">{network}</span>
                    <span class="text-ink-muted block text-xs">{how}</span>
                  </span>
                  <span class="text-ink text-xs font-semibold">{state}</span>
                </li>
              ))}
            </ol>
            <p class="text-ink-muted mt-auto pt-3 text-center text-xs">{journey.note}</p>
          </div>
        )
      }
      {
        screen === 'proof' && (
          <div class="flex flex-1 flex-col p-4">
            <p class="text-ink text-base font-bold">{proof.title}</p>
            <div class="mt-4 flex flex-col items-center">
              <svg
                class="text-primary h-16 w-16"
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="32" cy="32" r="26" />
                <circle cx="32" cy="32" r="19" stroke-dasharray="3 4" />
                <path d="m23 32 6 6 12-12" />
              </svg>
              <p class="text-ink mt-2 font-bold">{proof.seal}</p>
            </div>
            <dl class="border-line bg-surface mt-4 grid gap-2 rounded-xl border p-3 text-xs">
              {proof.rows.map(({ term, detail }) => (
                <div class="flex justify-between gap-3">
                  <dt class="text-ink-muted">{term}</dt>
                  <dd class="text-ink text-right font-semibold">{detail}</dd>
                </div>
              ))}
            </dl>
            <p class="text-ink-muted mt-auto pt-3 text-center text-xs">{proof.note}</p>
          </div>
        )
      }
    </div>
  </div>
  <figcaption class="text-ink-muted mt-3 text-center text-sm">
    {caption}. {label}; nothing in it saves.
  </figcaption>
</figure>
