---
/**
 * Theme choice.
 *
 * The default is the device's own light/dark preference, mapped to deep teal and true
 * black. Picking any of the four themes pins it; "System default" hands it back. There is
 * no separate light/dark switch, because each theme is already one or the other.
 *
 * The palettes and their names come from the app (see src/data/themes.ts), so a visitor
 * who later installs it meets the same four and the same words.
 */
import { DARK_THEME_IDS, LIGHT_THEME_IDS, LABELS, THEMES } from '@/data/themes';

const rowClass =
  'flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-left text-sm text-ink transition hover:bg-surface-muted aria-checked:bg-primary-tint aria-checked:font-semibold';
const groupClass =
  'px-2.5 pt-3 pb-1.5 text-xs font-semibold tracking-wider text-ink-muted uppercase';
---

<details class="relative" data-theme-picker>
  <summary
    class="border-line text-ink-muted hover:bg-surface-muted hover:text-ink inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border transition"
    aria-label={LABELS.title}
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
    </svg>
  </summary>

  <div
    class="border-line bg-surface absolute right-0 z-50 mt-2 w-60 rounded-xl border p-2 shadow-lg"
    role="radiogroup"
    aria-label={LABELS.title}
  >
    <button
      type="button"
      role="radio"
      aria-checked="false"
      data-theme-choice="system"
      class={rowClass}
    >
      <span
        class="border-line-strong flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full border"
      >
        <span class="bg-primary hidden h-2 w-2 rounded-full" data-dot></span>
      </span>
      {LABELS.system}
    </button>
    <p class="text-ink-muted px-2.5 pt-1 pb-1 text-xs leading-relaxed">{LABELS.systemHint}</p>

    <p class={groupClass}>{LABELS.light}</p>
    {
      LIGHT_THEME_IDS.map((id) => (
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-choice={id}
          class={rowClass}
        >
          <span
            class="border-line h-4 w-4 flex-shrink-0 rounded-full border"
            style={`background: ${THEMES[id].primary}`}
          />
          {LABELS.theme[id]}
        </button>
      ))
    }

    <p class={groupClass}>{LABELS.dark}</p>
    {
      DARK_THEME_IDS.map((id) => (
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-choice={id}
          class={rowClass}
        >
          <span
            class="border-line h-4 w-4 flex-shrink-0 rounded-full border"
            style={`background: ${THEMES[id].ground}; box-shadow: inset 0 0 0 2px ${THEMES[id].primary}`}
          />
          {LABELS.theme[id]}
        </button>
      ))
    }
  </div>
</details>

<script>
  import { isDarkTheme, isThemeId, resolveThemeId } from '@/data/themes';

  const KEY = 'theme';
  const media = matchMedia('(prefers-color-scheme: dark)');

  function stored(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null; // private mode or blocked storage
    }
  }

  function apply() {
    const choice = stored();
    const id = resolveThemeId(choice, media.matches ? 'dark' : 'light');
    const root = document.documentElement;
    root.dataset.theme = id;
    root.dataset.scheme = isDarkTheme(id) ? 'dark' : 'light';

    const selected = isThemeId(choice) ? choice : 'system';
    for (const button of document.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
      const on = button.dataset.themeChoice === selected;
      button.setAttribute('aria-checked', String(on));
      button.querySelector<HTMLElement>('[data-dot]')?.classList.toggle('hidden', !on);
    }
  }

  const picker = document.querySelector<HTMLDetailsElement>('[data-theme-picker]');

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const button = target?.closest<HTMLElement>('[data-theme-choice]');

    if (button) {
      const choice = button.dataset.themeChoice!;
      try {
        if (choice === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, choice);
      } catch {
        /* the choice still applies to this page view */
      }
      apply();
      return;
    }

    if (picker?.open && !picker.contains(target as Node)) picker.open = false;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && picker?.open) picker.open = false;
  });

  // Only matters while no theme is pinned, but apply() re-resolves either way.
  media.addEventListener('change', apply);

  apply();
</script>
