---
import Logo from '@/components/Logo.astro';
import ThemePicker from '@/components/ThemePicker.astro';
import { NAV, CONTACT } from '@/data/site';

// build.format is 'file', so at build time the pathname is "/clinic-app.html"
// and the home page is "/index.html". Normalise both to the href in NAV.
const here = Astro.url.pathname.replace(/(?:index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const isCurrent = (href: string) => here === href;
---

<header class="border-line bg-ground/85 sticky top-0 z-40 border-b backdrop-blur-md">
  <nav
    class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Main"
  >
    <a href="/" class="rounded-lg" aria-label="cosys.work — home">
      <Logo />
    </a>

    <ul class="ml-auto hidden items-center gap-1 lg:flex">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class:list={[
                'relative rounded-lg px-3 py-2 text-sm font-medium transition',
                'after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:rounded-full',
                isCurrent(href)
                  ? 'text-ink after:bg-primary font-semibold'
                  : 'text-ink-muted hover:text-ink hover:after:bg-line-strong',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <ThemePicker />
      <a
        href={`mailto:${CONTACT.email}`}
        class="bg-primary hover:bg-primary-pressed text-on-fill hidden rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition sm:inline-flex"
      >
        Get in touch
      </a>
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="border-line text-ink-muted hover:bg-surface-muted inline-flex h-9 w-9 items-center justify-center rounded-lg border transition lg:hidden"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" hidden class="border-line border-t lg:hidden">
    <ul class="mx-auto max-w-7xl space-y-1 px-4 py-3 sm:px-6">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class:list={[
                'block rounded-r-lg border-l-2 px-3 py-2.5 text-sm font-medium',
                isCurrent(href)
                  ? 'border-primary text-ink font-semibold'
                  : 'text-ink-muted hover:bg-surface-muted hover:text-ink border-transparent',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('mobile-nav');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
