---
import Logo from '@/components/Logo.astro';
import { SITE, CONTACT, PRODUCTS } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="border-line bg-surface-muted border-t">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <Logo />
        <p class="text-ink-muted mt-4 max-w-sm text-sm leading-relaxed">
          {SITE.tagline} Offline-first health software built on a peer-to-peer trust network, so medical
          records stay with the people they belong to.
        </p>
        <p class="text-ink-muted mt-4 text-sm">{CONTACT.locations}</p>
      </div>

      <div>
        <h2 class="text-ink text-sm font-semibold">Products</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            PRODUCTS.map(({ slug, name }) => (
              <li>
                <a href={slug} class="hover:text-primary text-ink-muted transition">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-ink text-sm font-semibold">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            [
              { label: 'About cosys.work', href: '/company' },
              { label: 'Contact', href: '/contact' },
              { label: 'Privacy', href: '/privacy' },
            ].map(({ label, href }) => (
              <li>
                <a href={href} class="hover:text-primary text-ink-muted transition">
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${CONTACT.email}`}
              class="hover:text-primary text-ink-muted transition"
            >
              {CONTACT.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-line text-ink-muted mt-12 flex flex-col gap-3 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.legalName} All rights reserved.</p>
      <p>
        cosys.work products keep records, they do not practise medicine. Treatment decisions stay
        with your licensed clinician.
      </p>
    </div>
  </div>
</footer>
