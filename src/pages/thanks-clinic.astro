---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
---

<Base title="Thank you" description="Your details reached us." path="/thanks-clinic">
  <Section class="!py-24 lg:!py-32">
    <div class="mx-auto max-w-lg text-center">
      <h1 class="text-ink text-3xl font-bold tracking-tight">Thank you. We'll contact you within a week to arrange a walkthrough.</h1>
      <a
        href="/clinic-app"
        class="bg-primary hover:bg-primary-pressed text-on-fill mt-8 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition"
      >
        Back to the Clinic App
      </a>
    </div>
  </Section>
</Base>
