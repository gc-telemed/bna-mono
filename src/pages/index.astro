---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/CTA.astro';
import { SITE, CONTACT, PRODUCTS, ACCENT } from '@/data/site';

const badges = [
  { icon: '📡', label: 'Offline-first' },
  { icon: '🔒', label: 'On-device AI' },
  { icon: '🤝', label: 'Peer-to-peer' },
  { icon: '🩺', label: 'Clinician-led' },
  { icon: '🧩', label: 'Open to plugins' },
];

const principles = [
  {
    emoji: '📡',
    title: 'Works with no signal',
    body: 'Logging, reminders, trends and the assistant all run on the device. Connectivity is something the apps use when it is there, never something they wait for.',
  },
  {
    emoji: '🔒',
    title: 'The AI stays on the phone',
    body: 'Lightweight models run locally, so health questions and personal readings are never shipped to an API. The assistant drafts and summarises; it never decides.',
  },
  {
    emoji: '🗄️',
    title: 'No corporate custody',
    body: 'We do not operate a data lake of patient records, because there is nothing to operate. Records live on patient devices and on the clinic systems that already hold them.',
  },
  {
    emoji: '🩺',
    title: 'Doctor-led by design',
    body: 'Our apps keep an honest record and make a clinician’s guidance easy to follow. They do not calculate doses and they do not offer a diagnosis.',
  },
  {
    emoji: '🗳️',
    title: 'Governed by the people using it',
    body: 'The patient-facing app is shaped by the community that lives with the condition, and any group is free to fork it and build the variant they need.',
  },
  {
    emoji: '🧩',
    title: 'Extensible by outsiders',
    body: 'Coaches, dietitians, clinics and independent developers publish plugins straight to the people who want them, over the same peer-to-peer fabric.',
  },
];

const flow = [
  {
    step: '01',
    title: 'The patient logs by photographing',
    body: 'A glucometer display, a lab report, a plate of food, a medication pack. The on-device AI drafts a structured entry and the patient confirms it. Seconds, not minutes.',
  },
  {
    step: '02',
    title: 'The record syncs to the clinic',
    body: 'On arrival — or ahead of a remote consultation — the patient approves a direct, encrypted connection to the clinic. Months of structured history land on the clinician’s screen before the conversation starts.',
  },
  {
    step: '03',
    title: 'The clinician annotates and plans',
    body: 'Notes attach to the exact readings that prompted them. The visit summary and updated plan are pushed back to the patient’s phone over the same connection — no email attachments, no lost printouts.',
  },
  {
    step: '04',
    title: 'The plan turns into care at home',
    body: 'A requested lab, a due refill or a dietary goal becomes a one-tap action routed to licensed local services. The patient approves every one. Nothing is ordered automatically.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  email: CONTACT.email,
  makesOffer: PRODUCTS.map(({ name, summary }) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'SoftwareApplication', name, description: summary },
  })),
};
---

<Base title={SITE.name} description={SITE.description} path="/" structuredData={structuredData}>
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-24">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="border-brand-300 bg-brand-50 text-brand-700 dark:border-brand-400/30 dark:bg-brand-400/10 dark:text-brand-300 inline-block rounded-full border px-4 py-1 text-sm font-medium"
      >
        Decentralised chronic care
      </span>
      <h1
        class="mt-6 text-4xl font-bold tracking-tight text-balance text-neutral-900 sm:text-5xl lg:text-6xl lg:leading-tight dark:text-white"
      >
        Health software that leaves{' '}<br class="hidden sm:block" />
        <span class="text-brand-600 dark:text-brand-400">your data where it belongs</span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400"
      >
        CoSys builds offline-first tools for long-term conditions: an app for the person living with
        one, an app for the clinic treating it, and a peer-to-peer network that moves records
        directly between them. There is no server in the middle holding anyone&rsquo;s medical
        history.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/diabetes-app"
          class="bg-brand-600 hover:bg-brand-700 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold text-white shadow-sm transition"
        >
          See the Diabetes App
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="/platform"
          class="inline-flex items-center gap-2 rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-neutral-800 shadow-sm transition hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:bg-neutral-800"
        >
          How the platform works
        </a>
      </div>

      <ul
        class="mt-10 flex flex-wrap items-center justify-center gap-2.5 text-sm text-neutral-600 dark:text-neutral-400"
      >
        {
          badges.map(({ icon, label }) => (
            <li class="flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 dark:bg-neutral-800">
              <span aria-hidden="true">{icon}</span>
              <span>{label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Flagship products -->
  <Section id="products">
    <SectionHeading
      eyebrow="Three products, one fabric"
      title="Built for both sides of the"
      accentTitle="consulting room door"
      lede="Each product is useful on its own. Together they close the loop between what happens in a patient's day and what a clinician can actually see."
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        PRODUCTS.map(({ slug, name, audience, blurb, accent, emoji }) => (
          <a
            href={slug}
            class:list={[
              'group flex flex-col rounded-2xl border border-neutral-200 bg-white p-8 transition hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900',
              ACCENT[accent].ring,
            ]}
          >
            <span class="text-4xl" aria-hidden="true">
              {emoji}
            </span>
            <span
              class:list={[
                'mt-5 inline-block w-fit rounded-full border px-3 py-0.5 text-xs font-medium',
                ACCENT[accent].chip,
              ]}
            >
              {audience}
            </span>
            <h3 class="mt-3 text-xl font-bold text-neutral-900 dark:text-neutral-100">{name}</h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
              {blurb}
            </p>
            <span
              class:list={[
                'mt-6 inline-flex items-center gap-1.5 text-sm font-semibold',
                ACCENT[accent].text,
              ]}
            >
              Learn more
              <svg
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- The problem -->
  <Section>
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <SectionHeading
          eyebrow="Why we build this way"
          title="A health record on someone else’s server"
          accentTitle="is a liability for everyone"
          align="left"
        />
        <div
          class="mt-5 space-y-4 leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400"
        >
          <p>
            The standard architecture for digital health pools everybody&rsquo;s readings into one
            place. That makes the pool valuable to the company holding it — and valuable to whoever
            breaches it. A single failure exposes millions of people at once, and the recovery is
            measured in months of disrupted care.
          </p>
          <p>
            It also fails quietly, every day, in a more ordinary way: the moment the connection
            drops, a cloud-dependent app stops being a medical tool. For anyone outside a city with
            reliable bandwidth, that is most of the time.
          </p>
          <p class="font-medium text-neutral-800 dark:text-neutral-200">
            We took the pool away. Records stay on the patient&rsquo;s device and on the systems of
            the clinics they explicitly trust. There is no third copy for us to lose.
          </p>
        </div>
      </div>

      <div class="grid gap-4">
        <div
          class="rounded-2xl border border-neutral-200 bg-neutral-50 p-7 dark:border-neutral-800 dark:bg-neutral-900"
        >
          <p
            class="mb-4 text-xs font-semibold tracking-wider text-neutral-400 uppercase dark:text-neutral-500"
          >
            Centralised health platforms
          </p>
          <ul class="space-y-3">
            {
              [
                'One breach exposes every patient at once',
                'Care stops working where the bandwidth stops',
                'The operator holds raw records, and the liability that comes with them',
                'Terms and ownership can change without the patient',
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-neutral-600 dark:text-neutral-400">
                  <svg
                    class="mt-0.5 h-4.5 w-4.5 flex-shrink-0 text-red-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <>
                      <circle cx="12" cy="12" r="10" />
                      <path d="m15 9-6 6M9 9l6 6" />
                    </>
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="border-brand-200 bg-brand-50 dark:border-brand-400/20 dark:bg-brand-400/5 rounded-2xl border p-7"
        >
          <p
            class="text-brand-700 dark:text-brand-400 mb-4 text-xs font-semibold tracking-wider uppercase"
          >
            The CoSys approach
          </p>
          <ul class="space-y-3">
            {
              [
                'Breaking one device gets you one device',
                'The full experience runs offline, by default',
                'Clinics keep records where they already keep them, under their own control',
                'The patient grants and revokes every connection',
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-300">
                  <svg
                    class="text-brand-500 mt-0.5 h-4.5 w-4.5 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- How it fits together -->
  <Section class="!py-0">
    <div
      class="rounded-3xl bg-neutral-100 px-6 py-14 sm:px-10 lg:px-16 lg:py-20 dark:bg-neutral-900/60"
    >
      <SectionHeading
        eyebrow="The loop"
        title="From a photo on a phone"
        accentTitle="to care at the front door"
        lede="Routine chronic care asks the patient to travel: to the clinic, to the lab, to the pharmacy. We run that in the other direction."
      />

      <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          flow.map(({ step, title, body }) => (
            <li class="rounded-2xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900">
              <span class="text-brand-500 dark:text-brand-400 text-sm font-bold tabular-nums">
                {step}
              </span>
              <h3 class="mt-2 font-semibold text-pretty text-neutral-900 dark:text-neutral-100">
                {title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                {body}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="mt-8 text-center text-sm text-neutral-500 dark:text-neutral-500">
        Physical visits are reserved for the part that genuinely needs a clinician in the room.
      </p>
    </div>
  </Section>

  <!-- Principles -->
  <Section>
    <SectionHeading
      eyebrow="What we hold to"
      title="Commitments we designed around,"
      accentTitle="not features we added later"
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {principles.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="Building this with clinics, coaches and patients"
      body="If you run a clinic that is tired of transcribing paperwork, live with a condition and have opinions about the tools, or write software and want to work on this — we want to hear from you."
      ctaLabel="Start a conversation"
      secondaryLabel="Read about CoSys"
      secondaryHref="/company"
    />
  </Section>
</Base>
