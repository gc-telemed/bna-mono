---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTA from '@/components/CTA.astro';
import NameBand from '@/components/NameBand.astro';
import HeroArt from '@/components/HeroArt.astro';
import Himalaya from '@/components/Himalaya.astro';
import Circles from '@/components/Circles.astro';
import Helix from '@/components/Helix.astro';
import DelayLadder from '@/components/DelayLadder.astro';
import { SITE, CONTACT, PRODUCTS, FORMS, LINKS, NAMES, OFFERS, THREADS } from '@/data/site';

// Every block below is new in v5 except `conditions`, `facts` and `promises`, kept from v4.3.
// needs_review: each block needs a Nepali version reviewed by a native speaker before launch.

const hero = {
  // The hero rotates through these every five seconds (CSS only, paused on hover, on focus, by
  // the Pause control, and for reduced motion). The first is the h1 that search engines and
  // screen readers get, and SITE.tagline repeats it. The others are aria-hidden.
  // needs_review: Nepali versions, and founder sign-off on the wording.
  headlines: [
    { title: 'Collaborative systems', accentTitle: 'with no centre to fail.' },
    {
      title: 'Families, clinics and offices working together,',
      accentTitle: 'each keeping its own copy.',
    },
    { title: 'Your records, your models and your bills,', accentTitle: 'under your own roof.' },
    {
      title: 'A clinic offline for a day is further away than Mars.',
      accentTitle: 'We build for both.',
    },
    {
      title: 'Built in Nepal, where the line drops every day,',
      accentTitle: 'and the work carries on.',
    },
  ],
  pause: 'Pause headlines',
  play: 'Play headlines',
  body: SITE.description,
  primary: { label: 'See what we build', href: '#what-we-build' },
  secondary: { label: 'Work with us', href: '#work-with-us' },
  links: [
    { lead: 'Living with diabetes?', label: 'Join the waitlist', href: FORMS.waitlist },
    { lead: 'Run a clinic?', label: 'Bring your clinic', href: FORMS.clinic },
  ],
  smallPrint: 'Built in Nepal. Open-source libraries under Apache-2.0.',
  art: {
    label:
      'A phone, a laptop and a clinic box joined directly to each other, with an empty space where a central server would usually sit',
    devices: { phone: 'Phone', laptop: 'Laptop', clinic: 'Clinic' },
    gap: ['no server', 'in the middle'],
  },
};

const whoWeAreLabel = 'Who we are';
const whoWeAre =
  'CoSys Work Pvt. Ltd. is a software company in Nepal. Cosys stands for collaborative systems: software for families, clinics, teams and communities that need to work together without handing their records to a platform. We build our own products, starting with apps for people living with diabetes and the clinics that care for them. We also help companies, organisations and ministries move their systems onto machines they own. Our framework is open source, and the network it runs on, nep.work, has no centre to fail.';

const ideas = {
  collaborative: {
    eyebrow: 'Collaborative systems',
    title: 'Built for people',
    accentTitle: 'who work together',
    body: [
      'Most software treats you as one account on someone else’s server. Ours starts from the groups people already belong to: a family, a clinic, a team, a cooperative. Each group holds its own keys, its own copy of what concerns it, and its own rules for who joins. Someone who belongs to two groups links them, and each group stays itself.',
      'Shared editing works offline and merges when people reconnect. Every entry is signed by whoever wrote it, and edits keep their history. You decide who sees what, and you can take it back.',
    ],
    example:
      'In the Diabetes App, a patient chooses whether family sees the numbers, a colour, or only an alert.',
  },
  dna: {
    eyebrow: 'Peer-to-peer DNA',
    title: 'Peer to peer',
    accentTitle: 'is in our DNA',
    body: [
      'Everything we build starts from the same rules, whether it is a product, an engagement or a library we publish.',
      'Your keys stay on your devices, and every entry is signed with them. Your copy of the record is the record, and it syncs with the people you chose whenever there is a connection. Relays carry sealed mail they cannot read. Everything works offline and catches up later. The code is open under Apache-2.0, so anyone can check that all of this is true.',
    ],
    example:
      'The Diabetes App logs readings, reads photos and shows trends in airplane mode. Its mailbox carries sealed deposits it cannot open.',
    libraries: 'Our libraries are published on npm, JSR and crates.io.',
    librariesLink: 'See the source on GitHub',
  },
  beyond: {
    eyebrow: 'Beyond Earth',
    title: 'Built for distance',
    accentTitle: 'and delay',
    body: [
      'We treat delay and disconnection as normal, although most software assumes the connection is instant and always there. Every copy is signed, can wait as long as it needs to, and catches up with the others in a known time.',
      'That is what keeps a clinic in rural Nepal working through a power cut, and a network between planets needs the same thing. Light takes about 1.3 seconds to reach the Moon, and between about 4 and 24 minutes to reach Mars, depending on where the planets are. A clinic that is offline for a day is, in network terms, further away than Mars.',
      // The EGU and NASA ADS sentence stays out until the founder confirms it (copy source, check 2).
      'Space agencies solve this with delay-tolerant networking, which stores a message and forwards it when the next link opens. Signed, self-contained records suit that way of travelling. coplanetary.work applies the same approach to social media and shared records, so they stay consistent across any distance. Nothing we run is in space today. This is a design rule, and the direction we are heading.',
    ],
  },
};

// Words inside the drawings, kept here like the rest of the copy so the Nepali versions can be
// dropped in later.
const circles = {
  title: 'Each group holds its own keys and its own copy',
  label:
    'Family, Clinic and Community as overlapping circles. Each group holds its own keys and its own copy. A patient belongs to Family and Clinic, a nurse to Clinic and Community, and no server sits in the middle.',
  groups: ['Family', 'Clinic', 'Community'],
  own: ['own keys', 'own copy'],
  people: ['a patient, in both', 'a nurse, in both'],
  caption: 'No server in the middle: each circle syncs among its own members.',
};

// Grew from v4.3's three pillars (peer-to-peer, private, sovereign) into five rules.
const helix = {
  title: 'The same rules come with everything we build',
  label:
    'A double helix pairing what stays with you with what the network does: your keys and entries signed, your copy and syncs when online, sealed records and relays can’t read, works offline and catches up later, open source and Apache-2.0.',
  withYou: 'With you',
  onNetwork: 'On the network',
  rungs: [
    { stays: 'Your keys', network: 'Entries signed' },
    { stays: 'Your copy', network: 'Syncs when online' },
    { stays: 'Sealed records', network: 'Relays can’t read' },
    { stays: 'Works offline', network: 'Catches up later' },
    { stays: 'Open source', network: 'Apache-2.0' },
  ],
};

const delay = {
  title: 'A clinic offline for a day is further away than Mars',
  label:
    'One-way delays, not to scale: milliseconds in the same room, a fraction of a second across a country, about 1.3 seconds from Earth to the Moon, 4 to 24 minutes from Earth to Mars, and hours to days for a clinic offline. One rule covers the whole range: sign every copy, let it wait, catch up later.',
  axis: 'One-way delay, longer to the right (not to scale)',
  axisNarrow: 'One-way delay, longer further down (not to scale)',
  rule: 'One rule for the whole range: sign every copy, let it wait, catch up later',
  steps: [
    { place: 'Same room', delay: ['milliseconds'] },
    { place: 'Across a country', delay: ['a fraction', 'of a second'] },
    { place: 'Earth to Moon', delay: ['about 1.3 seconds'] },
    { place: 'Earth to Mars', delay: ['4 to 24 minutes'] },
    { place: 'Clinic offline', delay: ['hours to days'], highlight: true },
  ],
};

const diabetesApp = PRODUCTS.find((p) => p.slug === '/diabetes-app')!;
const clinicApp = PRODUCTS.find((p) => p.slug === '/clinic-app')!;
const soma = PRODUCTS.find((p) => p.slug === '/soma')!;

const build = [
  {
    title: 'The Diabetes App and the Clinic App',
    audience: 'For patients and clinics',
    body: 'Apps for people living with diabetes and the clinics that care for them. The record stays on the patient’s phone and at the clinic, and family see only what the patient chooses. The Diabetes App is in closed pilot, and the Clinic App is in development.',
    links: [
      { label: diabetesApp.name, href: diabetesApp.slug },
      { label: clinicApp.name, href: clinicApp.slug },
    ],
  },
  {
    title: soma.name,
    audience: soma.audience,
    body: soma.blurb,
    links: [{ label: `About ${soma.name}`, href: soma.slug }],
  },
  {
    title: 'The open @cosys framework',
    audience: 'For developers',
    body: 'The libraries our products run on, free under Apache-2.0: @cosys packages on npm and JSR, and cosys- crates on crates.io.',
    links: [{ label: 'See it on GitHub', href: LINKS.framework }],
  },
];

const workWithUs = {
  eyebrow: 'Work with us',
  title: 'Your own systems,',
  accentTitle: 'in production',
  lede: 'For teams who want their own systems in production, on machines they own.',
  more: 'How we work together',
  // v5.1: the band under the two cards. Items come from THREADS in site.ts and link to their
  // thread on About us. needs_review: Nepali version, reviewed by a native speaker.
  bandTitle: 'What stays with you',
  bandLede: 'Five things every system we build keeps under its owner’s control.',
};

const health = {
  eyebrow: 'Health in Nepal',
  title: 'Specialised apps for each condition.',
  accentTitle: 'Starting with diabetes.',
  lede: 'Each condition gets an app built for it, and they share one record on your phone, because many people live with more than one.',
  factsTitle: 'Why Nepal, why now',
};

const conditions = [
  {
    title: 'Diabetes',
    body: 'The Diabetes App, the first of them. Photo logging, your doctor’s plan, and family who help.',
    href: '/diabetes-app',
    status: 'In closed pilot',
  },
  {
    title: 'Blood pressure',
    body: 'Readings, medicines and your doctor’s targets, over time.',
    status: 'Coming soon',
  },
  {
    title: 'Menopause',
    body: 'Symptoms, cycles and treatments, noted in your own words.',
    status: 'Coming soon',
  },
  {
    title: 'Arthritis',
    body: 'Pain, stiffness, medicines and what helps, day by day.',
    status: 'Coming soon',
  },
  {
    title: 'And more',
    body: 'Conditions rarely come alone. The apps share one record, so they work together.',
    status: 'Coming soon',
  },
];

const facts = [
  {
    figure: '22%',
    body: 'of adults over 30 had high blood sugar in the capital’s 2024–25 screening of 19,660 people.',
    source: 'Source: Kathmandu Post, Nov 2025',
  },
  {
    figure: '2–3 months',
    body: 'is how often most people with diabetes see a doctor. Sugar levels change every day.',
  },
  {
    figure: '1–2 hours',
    body: 'of intake for a 5–15 minute consultation, in the clinics we’ve spoken to.',
    source: 'What we have seen, not a formal study.',
  },
];

const promises = [
  {
    title: 'Your doctor decides; the app remembers',
    body: 'It never calculates or recommends insulin doses, and it never estimates carbohydrates or calories.',
  },
  {
    title: 'Your record belongs to you',
    body: 'Export it at any time as PDF or CSV, or as an encrypted backup only your passphrase opens. There is no cloud copy of your record.',
  },
  {
    title: 'Built for the hard case first',
    body: 'It runs on low-cost Android phones, on slow networks and in Nepali.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  email: CONTACT.email,
  sameAs: [LINKS.framework],
  makesOffer: PRODUCTS.map(({ name, summary }) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'SoftwareApplication', name, description: summary },
  })),
};

const primary =
  'bg-primary hover:bg-primary-pressed text-on-fill inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition';
const secondary =
  'border-line-strong bg-surface text-ink hover:bg-surface-muted inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold shadow-sm transition';
// Primary on the muted band is 4.47:1 in pink, so links inside a band use ink, underlined.
const textLink = 'text-primary font-semibold underline-offset-2 hover:underline';
const prose = 'text-ink-muted space-y-4 leading-relaxed text-pretty';
const example =
  'border-primary/30 bg-primary-tint text-ink rounded-2xl border px-5 py-4 text-sm leading-relaxed';
const arrow = 'M5 12h14M12 5l7 7-7 7';
---

<Base
  title={SITE.name}
  description={SITE.description}
  path="/"
  structuredData={structuredData}
  headerTone="dark"
>
  <!--
    The dark band: the hero over a drawn Himalaya, then Who we are and the three names, on a
    night version of the theme (.band-dark in global.css), handed back to the page by a fog bank.
  -->
  <div class="band-dark relative overflow-hidden pb-24 sm:pb-36">
    <!-- Hero -->
    <div class="relative">
      <div
        class="absolute inset-x-0 bottom-0 h-[clamp(200px,30vw,380px)] sm:h-[calc(clamp(200px,30vw,380px)+24px)]"
      >
        <Himalaya part="range" />
      </div>
      <Section class="relative !pt-20 !pb-[clamp(200px,30vw,380px)] lg:!pt-28">
        <div>
          <div class="mx-auto max-w-4xl text-center">
            <div class="headline-rotator relative">
              <h1
                class="text-ink grid items-center text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-tight"
              >
                {
                  hero.headlines.map(({ title, accentTitle }, i) => (
                    <span
                      class="headline"
                      style={`--n: ${i}`}
                      aria-hidden={i === 0 ? undefined : 'true'}
                    >
                      {title} <br class="hidden sm:block" />
                      <span class="text-primary">{accentTitle}</span>
                    </span>
                  ))
                }
              </h1>
              <div class="headline-controls">
                <span class="headline-dots" aria-hidden="true">
                  {hero.headlines.map((_, i) => <span class="headline-dot" style={`--n: ${i}`} />)}
                </span>
                <label class="headline-pause text-ink-muted hover:text-ink">
                  <input type="checkbox" class="sr-only" />
                  <span class="sr-only">{hero.pause}</span>
                  <svg
                    class="icon-pause h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <rect x="6" y="5" width="4" height="14" rx="1"></rect>
                    <rect x="14" y="5" width="4" height="14" rx="1"></rect>
                  </svg>
                  <svg
                    class="icon-play h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M8 5.5v13a1 1 0 0 0 1.5.87l11-6.5a1 1 0 0 0 0-1.74l-11-6.5A1 1 0 0 0 8 5.5Z"
                    ></path>
                  </svg>
                  <span class="headline-tip tip-pause" aria-hidden="true">{hero.pause}</span>
                  <span class="headline-tip tip-play" aria-hidden="true">{hero.play}</span>
                </label>
              </div>
            </div>
            <p class="text-ink-muted mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-pretty">
              {hero.body}
            </p>

            <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
              <a href={hero.primary.href} class={primary}>
                {hero.primary.label}
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={arrow}></path>
                </svg>
              </a>
              <a href={hero.secondary.href} class={secondary}>{hero.secondary.label}</a>
            </div>
            <ul
              class="mt-6 flex flex-col items-center justify-center gap-x-6 gap-y-2 text-sm sm:flex-row"
            >
              {
                hero.links.map(({ lead, label, href }) => (
                  <li class="text-ink-muted">
                    {lead}{' '}
                    <a href={href} class={textLink}>
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="text-ink-muted mt-5 text-sm italic">{hero.smallPrint}</p>
          </div>
        </div>
      </Section>
    </div>

    <!-- Who we are -->
    <Section class="!pt-6">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-16">
        <div>
          <h2
            class="text-ink-muted text-xs font-semibold tracking-[0.22em] uppercase"
            style="font-family: inherit"
          >
            {whoWeAreLabel}
          </h2>
          <p
            class="text-ink mt-4 text-xl leading-relaxed text-pretty sm:text-2xl sm:leading-relaxed"
          >
            {
              whoWeAre
                .split(/(?<=\.)\s+/)
                .map((sentence) => <span class="lightup">{sentence} </span>)
            }
          </p>
        </div>
        <HeroArt {...hero.art} class="mx-auto max-w-sm lg:max-w-none" />
      </div>
    </Section>

    <!-- cosys.work, nep.work and coplanetary.work -->
    <Section class="relative z-10 !pt-0">
      <NameBand names={NAMES} />
    </Section>
    <Himalaya part="fog" />
  </div>

  <!-- Collaborative systems -->
  <Section id="collaborative-systems" class="scroll-mt-20">
    <SectionHeading
      eyebrow={ideas.collaborative.eyebrow}
      title={ideas.collaborative.title}
      accentTitle={ideas.collaborative.accentTitle}
    />
    <div
      class="scrolly mt-10 lg:mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-16"
    >
      <div class="lg:pt-[6vh] lg:pb-[24vh]">
        <div class:list={['mx-auto max-w-3xl lg:max-w-none lg:space-y-[16vh]', prose]}>
          {ideas.collaborative.body.map((line) => <p class="lightup">{line}</p>)}
        </div>
        <p class:list={['lightup mx-auto mt-6 max-w-3xl lg:mt-[16vh] lg:max-w-none', example]}>
          {ideas.collaborative.example}
        </p>
      </div>
      <div class="mt-12 lg:sticky lg:top-28 lg:mt-0">
        <Circles {...circles} />
      </div>
    </div>
  </Section>

  <!-- Peer-to-peer DNA -->
  <Section id="peer-to-peer" class="scroll-mt-20 !py-0">
    <div class="bleed bg-surface-muted py-16 lg:py-24">
      <SectionHeading
        eyebrow={ideas.dna.eyebrow}
        title={ideas.dna.title}
        accentTitle={ideas.dna.accentTitle}
      />
      <div
        class="scrolly mt-10 lg:mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-16"
      >
        <div class="lg:pt-[6vh] lg:pb-[24vh]">
          <div class:list={['mx-auto max-w-3xl lg:max-w-none lg:space-y-[16vh]', prose]}>
            {ideas.dna.body.map((line) => <p class="lightup">{line}</p>)}
          </div>
          <p class:list={['lightup mx-auto mt-6 max-w-3xl lg:mt-[16vh] lg:max-w-none', example]}>
            {ideas.dna.example}
          </p>
        </div>
        <div class="mt-12 lg:sticky lg:top-28 lg:mt-0">
          <Helix {...helix} layout="upright-lg" />
        </div>
      </div>
      <p class="text-ink-muted mx-auto mt-6 max-w-3xl text-center text-sm">
        {ideas.dna.libraries}{' '}
        <a href={LINKS.framework} class="text-ink font-semibold underline underline-offset-2">
          {ideas.dna.librariesLink}</a
        >
      </p>
    </div>
  </Section>

  <!-- Beyond Earth -->
  <Section id="beyond-earth" class="scroll-mt-20">
    <SectionHeading
      eyebrow={ideas.beyond.eyebrow}
      title={ideas.beyond.title}
      accentTitle={ideas.beyond.accentTitle}
    />
    <div
      class="scrolly mt-10 lg:mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-16"
    >
      <div class="lg:pt-[6vh] lg:pb-[24vh]">
        <div class:list={['mx-auto max-w-3xl lg:max-w-none lg:space-y-[16vh]', prose]}>
          {ideas.beyond.body.map((line) => <p class="lightup">{line}</p>)}
        </div>
      </div>
      <div class="mt-12 lg:sticky lg:top-28 lg:mt-0">
        <DelayLadder {...delay} layout="column-lg" />
      </div>
    </div>
  </Section>

  <!-- What we build -->
  <Section id="what-we-build" class="scroll-mt-20 !pt-0">
    <SectionHeading
      eyebrow="What we build"
      title="Our own products,"
      accentTitle="and the framework under them"
    />
    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        build.map(({ title, audience, body, links }) => (
          <div class="reveal border-line bg-surface flex flex-col rounded-2xl border p-8">
            <span class="border-primary/30 bg-primary-tint text-ink inline-block w-fit rounded-full border px-3 py-0.5 text-xs font-medium">
              {audience}
            </span>
            <h3 class="text-ink mt-3 text-xl font-bold">{title}</h3>
            <p class="text-ink-muted mt-2.5 flex-1 text-sm leading-relaxed">{body}</p>
            <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              {links.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-primary inline-flex items-center gap-1.5 font-semibold"
                  >
                    {label}
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={arrow} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Work with us -->
  <Section id="work-with-us" class="scroll-mt-20 !pt-0">
    <SectionHeading
      eyebrow={workWithUs.eyebrow}
      title={workWithUs.title}
      accentTitle={workWithUs.accentTitle}
      lede={workWithUs.lede}
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        OFFERS.map(({ title, body }) => (
          <a
            href="/company#work-with-us"
            class="group reveal lift border-line bg-surface hover:border-primary/40 flex flex-col rounded-2xl border p-8 transition hover:shadow-lg focus-visible:shadow-lg"
          >
            <h3 class="text-ink text-xl font-bold">{title}</h3>
            <p class="text-ink-muted mt-2.5 flex-1 text-sm leading-relaxed">{body}</p>
            <span class="text-primary mt-6 inline-flex items-center gap-1.5 text-sm font-semibold">
              {workWithUs.more}
              <svg
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={arrow} />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <!--
      What stays with you: a pinned heading and a deck of cards that roll up over each other as
      the page scrolls (position: sticky with stepped offsets, no script).
    -->
    <div class="mt-20 lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-32">
        <h3 class="text-ink text-center text-2xl font-bold lg:text-left lg:text-3xl">
          {workWithUs.bandTitle}
        </h3>
        <p class="text-ink-muted mt-3 text-center lg:text-left">{workWithUs.bandLede}</p>
      </div>
      <ol class="stack mt-8 lg:mt-0">
        {
          THREADS.map(({ id, label, line }, i) => (
            <li class="stack-card" style={`--i: ${i}`}>
              <a
                href={`/company#${id}`}
                class="group lift border-line bg-surface hover:border-primary/40 flex min-h-36 w-full flex-col rounded-2xl border p-6 shadow-[0_-8px_24px_-16px_rgb(0_0_0/0.35)] transition hover:shadow-lg focus-visible:shadow-lg sm:p-7"
              >
                <span class="text-primary text-sm font-bold tabular-nums" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-ink mt-2 inline-flex items-center gap-1.5 text-lg font-bold">
                  {label}
                  <svg
                    class="text-primary h-4 w-4 flex-shrink-0 transition group-hover:translate-x-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={arrow} />
                  </svg>
                </span>
                <span class="text-ink-muted mt-1.5 leading-relaxed">{line}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Health in Nepal -->
    <Section id="health" class="scroll-mt-20 !py-0">
      <div class="bleed bg-surface-muted py-16 lg:py-24">
        <SectionHeading
          eyebrow={health.eyebrow}
          title={health.title}
          accentTitle={health.accentTitle}
          lede={health.lede}
        />
        <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:mt-12 lg:grid-cols-5 lg:gap-5">
          {
            conditions.map(({ title, body, href, status }) => {
              const Tag = href ? 'a' : 'div';
              return (
                <Tag
                  href={href}
                  class:list={[
                    'reveal border-line bg-surface flex rounded-2xl border p-5 lg:p-6',
                    href &&
                      'lift hover:border-primary/40 transition hover:shadow-lg focus-visible:shadow-lg',
                  ]}
                >
                  <div class="flex flex-1 flex-col">
                    <p class="text-ink flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold">
                      {title}
                      <span
                        class:list={[
                          'inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium lg:hidden',
                          href
                            ? 'border-primary/30 bg-primary-tint text-ink'
                            : 'border-line text-ink-muted',
                        ]}
                      >
                        {status}
                      </span>
                    </p>
                    <p class="text-ink-muted mt-1.5 flex-1 text-sm leading-relaxed">{body}</p>
                    <span
                      class:list={[
                        'mt-4 hidden w-fit rounded-full border px-3 py-0.5 text-xs font-medium lg:inline-block',
                        href
                          ? 'border-primary/30 bg-primary-tint text-ink'
                          : 'border-line text-ink-muted',
                      ]}
                    >
                      {status}
                    </span>
                  </div>
                </Tag>
              );
            })
          }
        </div>

        <h3 class="text-ink mt-14 text-center text-xl font-bold">{health.factsTitle}</h3>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {
            facts.map(({ figure, body, source }) => (
              <div class="reveal border-line bg-surface rounded-2xl border p-6">
                <p class="text-primary text-3xl font-bold tabular-nums">{figure}</p>
                <p class="text-ink mt-2 text-sm leading-relaxed">{body}</p>
                {source && <p class="text-ink-muted mt-3 text-xs italic">{source}</p>}
              </div>
            ))
          }
        </div>

        <div class="mt-10">
          <CTA
            title="Built in Nepal"
            body="Patients: the Diabetes App is in closed pilot, so join the waitlist and we'll tell you when it is ready for you. Clinics: the Clinic App is in development, and a preview is available on request."
            ctaLabel="Join the patient waitlist"
            href={FORMS.waitlist}
            secondaryLabel="Bring your clinic"
            secondaryHref={FORMS.clinic}
          />
        </div>
      </div>
    </Section>

    <!-- Promises -->
    <Section>
      <SectionHeading
        eyebrow="Our promises"
        title="What our health apps will"
        accentTitle="always and never do"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          promises.map(({ title, body }, i) => (
            <div class="reveal border-line border-t pt-6">
              <p
                class="text-primary text-5xl leading-none font-bold tabular-nums"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="text-ink mt-4 text-xl font-semibold">{title}</h3>
              <p class="text-ink-muted mt-2 leading-relaxed">{body}</p>
            </div>
          ))
        }
      </div>
    </Section>
  </Section>
</Base>
