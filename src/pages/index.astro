---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/CTA.astro';
import { SITE, CONTACT, PRODUCTS, FORMS } from '@/data/site';

const conditions = [
  {
    emoji: '🩸',
    title: 'Diabetes',
    body: 'The Diabetes App, the first of them. Photo logging, your doctor’s plan, and family who help.',
    href: '/diabetes-app',
    status: 'Being built now',
  },
  { emoji: '🩺', title: 'Blood pressure', body: 'Readings, medicines and your doctor’s targets, over time.', status: 'Coming soon' },
  { emoji: '🌸', title: 'Menopause', body: 'Symptoms, cycles and treatments, noted in your own words.', status: 'Coming soon' },
  { emoji: '🦴', title: 'Arthritis', body: 'Pain, stiffness, medicines and what helps, day by day.', status: 'Coming soon' },
  { emoji: '➕', title: 'And more', body: 'Conditions rarely come alone. The apps share one record, so they work together.', status: 'Coming soon' },
];

const pillars = [
  {
    emoji: '🤝',
    title: 'Peer-to-peer',
    body: 'Your record moves directly between your phone and the people you choose: family who help, and later your clinic. No central server holds it.',
  },
  {
    emoji: '🔒',
    title: 'Private',
    body: 'Photos are read and questions answered on your phone. Anything that travels is sealed so only the phones you chose can open it.',
  },
  {
    emoji: '🗝️',
    title: 'Sovereign',
    body: 'The record is yours. You decide who sees what, you can end any share, and you can take the whole of it with you as a file.',
  },
];

const steps = [
  {
    step: '01',
    title: 'Snap',
    body: 'Photograph your glucometer or a lab report. The number is read on your phone, and you check it before it’s saved. This works in airplane mode.',
  },
  {
    step: '02',
    title: 'Share',
    body: 'Choose family members who help you, and choose what each one sees. Before a visit, make a one-page summary of your last month as a PDF to show or send your doctor. When your clinic joins through the Clinic App, you’ll scan its QR code and the summary reaches your doctor directly.',
  },
  {
    step: '03',
    title: 'Follow',
    body: 'Your targets, medicines and your doctor’s instructions sit on a plan card on your phone, with reminders for your medicines. Later, with the Clinic App, your clinic will be able to set the plan and send a checklist of next tests.',
  },
];

const facts = [
  {
    figure: '22%',
    body: 'of Kathmandu residents over 30 had high blood sugar in the city’s 2024–25 screening of 19,660 people.',
    source: 'Source: Kathmandu Post, Nov 2025',
  },
  {
    figure: '2–3 months',
    body: 'is how often most people with diabetes see a doctor. Sugar levels change every day.',
  },
  {
    figure: '1–2 hours',
    body: 'of intake for a 5–15 minute consultation, in the clinics we’ve spoken to.',
    source: 'What we have seen, not a formal study.',
  },
];

const comparison = [
  {
    dimension: 'Works with no signal',
    typical: 'Partly, or not at all',
    ours: 'Yes: logging, photos, your summary and reminders (the assistant too, on phones with about 6 GB of memory)',
  },
  { dimension: 'Where the AI runs', typical: 'In the cloud', ours: 'On your phone' },
  {
    dimension: 'Who holds your record',
    typical: 'The app company’s servers',
    ours: 'You, on your phone',
  },
  {
    dimension: 'Cost to patients',
    typical: 'Free trial, then a subscription',
    ours: 'Free, always',
  },
  {
    dimension: 'Share with family',
    typical: 'The full numbers',
    ours: 'Your choice for each person: the numbers, the range only, or alerts only',
  },
  {
    dimension: 'Your doctor’s targets',
    typical: 'Typed in by you, or none',
    ours: 'Your doctor’s, or published WHO and ADA values, always labelled with where they came from',
  },
];

const promises = [
  {
    emoji: '🩺',
    title: 'Your doctor decides; the app remembers',
    body: 'It never calculates or recommends insulin doses, and it never estimates carbohydrates or calories.',
  },
  {
    emoji: '🗄️',
    title: 'Your record belongs to you',
    body: 'Export it at any time as PDF or CSV, or as an encrypted backup only your passphrase opens. There is no cloud copy of your record.',
  },
  {
    emoji: '📡',
    title: 'Built for the hard case first',
    body: 'It runs on low-cost Android phones, on slow networks and in Nepali.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  email: CONTACT.email,
  makesOffer: PRODUCTS.map(({ name, summary }) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'SoftwareApplication', name, description: summary },
  })),
};

const primary =
  'bg-primary hover:bg-primary-pressed text-on-fill inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition';
const secondary =
  'border-line-strong bg-surface text-ink hover:bg-surface-muted inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold shadow-sm transition';
---

<Base title={SITE.name} description={SITE.description} path="/" structuredData={structuredData}>
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-24">
    <div class="mx-auto max-w-3xl text-center">
      <h1
        class="text-ink text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-tight"
      >
        Health care that keeps going{' '}<br class="hidden sm:block" />
        <span class="text-primary">between visits</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        Most care happens at home, in the months between clinic visits. cosys.work builds
        collaborative systems for that part: you, the family who help you, and your doctor, working
        on your care together. For chronic and comorbid conditions, starting with diabetes.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={FORMS.waitlist} class={primary}>
          Join the patient waitlist
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href={FORMS.clinic} class={secondary}>Bring your clinic</a>
      </div>
      <p class="text-ink-muted mt-5 text-sm italic">
        Peer-to-peer, private and sovereign. Being built in Kathmandu and Janakpur.
      </p>
    </div>
  </Section>

  <!-- Conditions -->
  <Section class="!pt-4">
    <SectionHeading
      eyebrow="One app for each condition"
      title="Specialised apps, coming soon."
      accentTitle="Starting with diabetes."
      lede="Each condition gets an app built for it, with the words, the readings and the plans that condition needs. They share one record on your phone, because many people live with more than one."
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {
        conditions.map(({ emoji, title, body, href, status }) => {
          const Tag = href ? 'a' : 'div';
          return (
            <Tag
              href={href}
              class:list={[
                'border-line bg-surface flex flex-col rounded-2xl border p-6',
                href && 'hover:border-primary/40 transition hover:shadow-lg',
              ]}
            >
              <span class="text-3xl" aria-hidden="true">
                {emoji}
              </span>
              <p class="text-ink mt-3 font-semibold">{title}</p>
              <p class="text-ink-muted mt-1.5 flex-1 text-sm leading-relaxed">{body}</p>
              <span
                class:list={[
                  'mt-4 inline-block w-fit rounded-full border px-3 py-0.5 text-xs font-medium',
                  href
                    ? 'border-primary/30 bg-primary-tint text-ink'
                    : 'border-line text-ink-muted',
                ]}
              >
                {status}
              </span>
            </Tag>
          );
        })
      }
    </div>
  </Section>

  <!-- Pillars -->
  <Section class="!pt-0">
    <div class="grid gap-5 md:grid-cols-3">
      {pillars.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- How it works -->
  <Section class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow="How it works, starting with diabetes"
        title="Snap, share,"
        accentTitle="follow the plan"
      />
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {
          steps.map(({ step, title, body }) => (
            <li class="border-line bg-surface rounded-2xl border p-6">
              <span class="text-primary text-sm font-bold tabular-nums">{step}</span>
              <h3 class="text-ink mt-2 font-semibold text-pretty">{title}</h3>
              <p class="text-ink-muted mt-2 text-sm leading-relaxed">{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- Why Nepal -->
  <Section>
    <SectionHeading
      eyebrow="Why Nepal, why now"
      title="Your body changes every day."
      accentTitle="Visits come every few months."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        facts.map(({ figure, body, source }) => (
          <div class="border-line bg-surface rounded-2xl border p-6">
            <p class="text-primary text-3xl font-bold tabular-nums">{figure}</p>
            <p class="text-ink mt-2 text-sm leading-relaxed">{body}</p>
            {source && <p class="text-ink-muted mt-3 text-xs italic">{source}</p>}
          </div>
        ))
      }
    </div>
  </Section>

  <!-- What makes it different -->
  <Section class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow="What makes it different"
        title="The Diabetes App, next to"
        accentTitle="a typical diabetes app"
      />
      <div class="border-line bg-surface mt-12 overflow-x-auto rounded-2xl border">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Typical diabetes apps compared with The Diabetes App</caption>
          <thead>
            <tr class="border-line border-b">
              <th scope="col" class="text-ink px-5 py-4 font-semibold">
                <span class="sr-only">What</span>
              </th>
              <th scope="col" class="text-ink-muted px-5 py-4 font-semibold">
                Typical diabetes apps
              </th>
              <th scope="col" class="text-primary px-5 py-4 font-semibold">The Diabetes App</th>
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {
              comparison.map(({ dimension, typical, ours }) => (
                <tr>
                  <th scope="row" class="text-ink px-5 py-4 align-top font-semibold">
                    {dimension}
                  </th>
                  <td class="text-ink-muted px-5 py-4 align-top">{typical}</td>
                  <td class="text-ink px-5 py-4 align-top">{ours}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Products -->
  <Section id="products">
    <SectionHeading
      eyebrow="Three products, one network"
      title="Built for both sides of the"
      accentTitle="consulting room door"
    />
    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        PRODUCTS.map(({ slug, name, audience, blurb, emoji }) => (
          <a
            href={slug}
            class="group border-line bg-surface hover:border-primary/40 flex flex-col rounded-2xl border p-8 transition hover:shadow-lg"
          >
            <span class="text-4xl" aria-hidden="true">
              {emoji}
            </span>
            <span class="border-primary/30 bg-primary-tint text-ink mt-5 inline-block w-fit rounded-full border px-3 py-0.5 text-xs font-medium">
              {audience}
            </span>
            <h3 class="text-ink mt-3 text-xl font-bold">{name}</h3>
            <p class="text-ink-muted mt-2.5 flex-1 text-sm leading-relaxed">{blurb}</p>
            <span class="text-primary mt-6 inline-flex items-center gap-1.5 text-sm font-semibold">
              Learn more
              <svg
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Promises -->
  <Section>
    <SectionHeading eyebrow="Our promises" title="What the app will" accentTitle="always and never do" />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {promises.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="Being built in Kathmandu and Janakpur"
      body="Clinics: see the Clinic App and request a walkthrough. Patients: join the waitlist for The Diabetes App, the first of the apps, and we'll tell you when it is ready for you."
      ctaLabel="Bring your clinic"
      href={FORMS.clinic}
      secondaryLabel="Join the patient waitlist"
      secondaryHref={FORMS.waitlist}
    />
  </Section>
</Base>
