---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import AppPreview from '@/components/AppPreview.astro';
import { SITE, PRODUCTS, FORMS } from '@/data/site';

const product = PRODUCTS[0]!;
const accent = 'text-primary';
const chip = 'border-primary/30 bg-primary-tint text-ink';

const capture = [
  {
    emoji: '🩸',
    title: 'Glucometer',
    body: 'Take a photo of the display. The number is read on your phone, and you confirm it before it’s saved. It works with the meters sold in Nepal; no Bluetooth needed.',
  },
  {
    emoji: '📄',
    title: 'Lab reports',
    body: 'Snap or pick your HbA1c, lipid or kidney report. The values are read on your phone and saved with the report’s date once you’ve checked them.',
  },
  {
    emoji: '🍛',
    title: 'Meals',
    body: 'Add a photo and your own note of how the meal felt: light, usual or heavy. Coming soon: a colour cue from the photo, trained on Nepali food, once its fine-tuning is done and it has regulatory approval. Until then your own note is the record.',
  },
  {
    emoji: '💊',
    title: 'Medicines',
    body: 'Answer a reminder with Taken, or tick the medicine when you take it.',
  },
  {
    emoji: '🩺',
    title: 'Blood pressure and weight',
    body: 'Type the numbers from your monitor or scale.',
  },
  {
    emoji: '📝',
    title: 'Notes',
    body: 'Type or speak a note, or mark a question “ask my doctor” so it’s on your next visit summary.',
  },
];

const readings = [
  'The share of your readings that were in your target range over the last 7, 14 or 30 days, with the range beside it and where it came from.',
  'Your average for each time of day: fasting, after meals, and so on.',
  'How many readings were under 70 mg/dL and under 54 mg/dL, each line labelled with its source.',
  'Your HbA1c from your lab reports, over time.',
];

const shareLevels = [
  { title: 'Numbers', body: 'Your readings, as you logged them.' },
  {
    title: 'Range only',
    body: 'Whether each reading was below, in or above your range, shown as a word and a colour, without the number.',
  },
  { title: 'Alerts only', body: 'Nothing, unless a reading crosses one of the alert lines.' },
];

const marketplace = [
  { emoji: '🧪', title: 'Lab tests', body: 'Book the tests on your doctor’s list.' },
  { emoji: '🏠', title: 'Home sample collection', body: 'A collector comes to you, so there is no queue.' },
  { emoji: '🏥', title: 'Clinic appointments', body: 'Book your next visit from the app.' },
  { emoji: '🦵', title: 'Physiotherapy', body: 'Appointments with physiotherapists.' },
  { emoji: '🥗', title: 'Dietitians', body: 'Appointments for help with what you eat.' },
  { emoji: '🏋️', title: 'Exercise at home', body: 'Video packages from gym coaches, to follow at home.' },
  { emoji: '📟', title: 'CGM plugins', body: 'Bring readings from a continuous glucose monitor.' },
  { emoji: '🩸', title: 'Glucometer plugins', body: 'Bring readings from a connected meter.' },
  { emoji: '💬', title: 'Telemedicine', body: 'Online consultations and appointments, from third-party providers.' },
];

const facts = [
  { term: 'Price', detail: 'Free forever. Services from third parties in the in-app marketplace, when it opens, are optional and paid to the provider.' },
  {
    term: 'Phones',
    detail: 'Android phones, including low-cost ones. Minimum Android version to be confirmed before launch.',
  },
  {
    term: 'Internet',
    detail:
      'Not needed for daily use. Updates to your family travel when you’re connected, sealed so that only their phones can read them. Syncing with your clinic arrives with the Clinic App.',
  },
  {
    term: 'The assistant',
    detail:
      'Ask about my log answers questions about your own entries, on phones with about 6 GB of memory. It never answers medical questions and never suggests a dose. Everything else works on every supported phone.',
  },
  {
    term: 'Your data',
    detail: 'Stays on your phone and on the phones you choose. Export it or back it up at any time.',
  },
  { term: 'Languages', detail: 'English and Nepali. Maithili is planned.' },
];

const faqs = [
  {
    question: 'When can I use it?',
    answer:
      'The Diabetes App is in a closed pilot in Nepal, and it is not open to the public yet. Join the waitlist and we will tell you when it is ready for you.',
  },
  {
    question: 'Does it really work with no internet?',
    answer:
      'Yes. Logging, reading a photo, your summary, your plan and your reminders all run on the phone. The internet is used only to send updates to the family members you chose, and it waits until you are connected.',
  },
  {
    question: 'Does the app calculate my insulin dose?',
    answer:
      'No, and it never will. The app is a record-keeping and communication tool. It does not calculate or recommend doses, and it does not estimate carbohydrates or calories. Dosing and treatment decisions belong to your doctor.',
  },
  {
    question: 'What happens to my photos?',
    answer:
      'They are read on your phone and never sent to a server. A number read from a photo is only a suggestion until you confirm it, and you can always type the value instead.',
  },
  {
    question: 'Where do the target ranges come from?',
    answer:
      'From your doctor, when you copy their targets onto the plan card. Where a target is missing, the app uses published values from the World Health Organization, with the American Diabetes Association’s where WHO has none, and it labels every figure those values affect.',
  },
  {
    question: 'Who sees my readings?',
    answer:
      'Only the people you add, at the level you choose for each: the numbers, the range only, or alerts only. Updates are sealed so only their phones can read them. You can change or remove anyone at any time.',
  },
  {
    question: 'Is an alert an emergency service?',
    answer:
      'No. An alert reaches your emergency contacts when your phone next has a signal, so it is not real time. In an emergency, call for help directly. The If I feel low card puts your contact’s call button first after a reading under 54 mg/dL.',
  },
  {
    question: 'What if I lose my phone?',
    answer:
      'Make an encrypted backup from the app and keep it somewhere safe. Only your passphrase opens it, and restoring it on a new phone brings your record back. There is no cloud copy, so the backup is the copy.',
  },
  {
    question: 'What does the assistant do?',
    answer:
      'Ask about my log answers questions about your own entries, such as your last reading or whether you took your medicine today, on phones with about 6 GB of memory. It runs on the phone, never answers medical questions, and never suggests a dose.',
  },
  {
    question: 'How does this work with my doctor?',
    answer:
      'Today, show or send them the one-page summary as a PDF. When your clinic uses the Clinic App, now in development, you will be able to scan its QR code and share your history directly, and your doctor will be able to set your plan.',
  },
  {
    question: 'How much does it cost?',
    answer: 'Nothing. The Diabetes App is free forever. The marketplace, when it opens, will offer optional services from third parties, such as lab tests or a dietitian appointment, which you pay the provider for.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  alternateName: 'tda by cosys',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Android',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
  description: product.summary,
  url: `${SITE.url}${product.slug}`,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};

const block = 'border-line bg-surface rounded-2xl border p-7';
---

<Base
  title={product.name}
  description={product.summary}
  path={product.slug}
  structuredData={structuredData}
>
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span class:list={['inline-block rounded-full border px-4 py-1 text-sm font-medium', chip]}>
        {product.audience}
      </span>
      <h1
        class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-tight"
      >
        A diabetes companion{' '}<br class="hidden sm:block" />
        <span class={accent}>that works with no signal</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        Log by photo, see your readings over time, and follow the plan your doctor gave you, all on
        your phone. For Type 2, Type 1, gestational diabetes and prediabetes.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={FORMS.waitlist}
          class="bg-primary text-on-fill hover:bg-primary-pressed inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          Join the patient waitlist
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="#preview"
          class="border-line-strong bg-surface text-ink hover:bg-surface-muted inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          Try the app
        </a>
      </div>
      <p class="text-ink-muted mt-5 text-sm italic">In closed pilot. Free forever.</p>
    </div>
  </Section>

  <!-- Log in seconds -->
  <Section id="capture">
    <SectionHeading
      eyebrow="Log in seconds"
      title="Point the camera at the source."
      accentTitle="You confirm every value."
      accentClass={accent}
      chipClass={chip}
      lede="Photos are read on the phone, so they never reach a server. A value read from a photo is a suggestion until you confirm it."
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {capture.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- The app itself -->
  <Section id="preview" class="!pt-4">
    <SectionHeading
      eyebrow="See it"
      title="This is the app."
      accentTitle="Try it right here."
      accentClass={accent}
      chipClass={chip}
      lede="A working replica of the real interface: the same screens, the same colours, the same words in English and Nepali. Nothing you do in it is saved."
    />
    <div class="mt-12">
      <AppPreview />
    </div>
  </Section>

  <!-- Readings and plan -->
  <Section class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <div class="grid gap-5 md:grid-cols-2">
        <div class={block}>
          <h2 class="text-ink text-xl font-bold">See your readings over time</h2>
          <ul class="text-ink-muted mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed">
            {readings.map((line) => <li>{line}</li>)}
          </ul>
          <p class="text-ink-muted mt-4 text-sm leading-relaxed">
            A reading outside your range is shown as it is, with no alarm colour and no verdict.
          </p>
        </div>
        <div class={block}>
          <h2 class="text-ink text-xl font-bold">Your doctor&rsquo;s plan, in your pocket</h2>
          <p class="text-ink-muted mt-4 text-sm leading-relaxed">
            Your targets, medicines and your doctor&rsquo;s instructions for a low sit on a plan card.
            You copy them from your prescription, and a photo of the prescription can fill the card
            in for you to check. Where your doctor hasn&rsquo;t set a target, the app uses published
            values from the World Health Organization, with the American Diabetes
            Association&rsquo;s where WHO has none, and says so beside every figure they affect.
            Every earlier version of your plan is kept.
          </p>
          <p class="text-ink-muted mt-3 text-sm leading-relaxed">
            When your clinic uses the Clinic App, your doctor will be able to set the plan directly.
            It will show who set it and when.
          </p>
        </div>
        <div class={block}>
          <h2 class="text-ink text-xl font-bold">If you feel low</h2>
          <p class="text-ink-muted mt-4 text-sm leading-relaxed">
            The <em>If I feel low</em> card on your home screen shows the steps you wrote down from
            your doctor and a button to call your emergency contact. After a reading under 54 mg/dL,
            the call button comes first. It works with no signal.
          </p>
          <p class="text-ink-muted mt-3 text-sm leading-relaxed">
            If you choose, the family members you mark as emergency contacts get a notification when
            a reading goes under 70 or under 54 mg/dL, or reaches 325 mg/dL. The notification names
            the line it crossed, never the number. It arrives when your phone next has a signal, so
            it is not real time, and it is not an emergency service.
          </p>
        </div>
        <div class={block}>
          <h2 class="text-ink text-xl font-bold">Reminders</h2>
          <p class="text-ink-muted mt-4 text-sm leading-relaxed">
            Reminders for your medicines, with <em>Taken</em>, <em>Not now</em> and{' '}
            <em>Snooze</em> on the notification itself. If a medicine reminder gets no answer, one
            follow-up arrives 30 minutes later, and never more than one. You can turn the follow-up
            off for each reminder.
          </p>
          <h2 class="text-ink mt-7 text-xl font-bold">Take a summary to your visit</h2>
          <p class="text-ink-muted mt-4 text-sm leading-relaxed">
            Make a PDF of the last 30 or 90 days in two taps. The first page is a single sheet your
            doctor can read in a minute: time in range, readings under the low lines, your medicines
            taken, your latest labs, blood pressure and weight, and your questions. The detail
            follows, and a spreadsheet (CSV) comes with it.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Share -->
  <Section>
    <SectionHeading
      eyebrow="Share the way you want"
      title="Choose what each person"
      accentTitle="in your family sees"
      accentClass={accent}
      chipClass={chip}
      lede="Add family members who help with your diabetes and choose a level for each one. You can change or remove anyone at any time."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {shareLevels.map((item) => <Card {...item} />)}
    </div>
    <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-center text-sm leading-relaxed text-pretty">
      Only the people you mark as emergency contacts get alerts. A relative who lives far away can
      follow along without being woken at night. A family member can also follow a parent&rsquo;s
      record on their own phone, read-only, alongside their own.
    </p>
  </Section>

  <!-- Marketplace -->
  <Section class="!pt-0">
    <SectionHeading
      eyebrow="The marketplace, coming soon"
      title="Free forever."
      accentTitle="Services from others, if you want them."
      accentClass={accent}
      chipClass={chip}
      lede="The app itself costs nothing, now or later. Inside it, a marketplace on the same peer-to-peer network will list services from third parties. Buying one is optional, the payment goes to the provider, and what they see of your record is your choice, as with any share."
    />
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:mt-12 lg:gap-5">
      {marketplace.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- Facts -->
  <Section class="!pt-0">
    <div class={block}>
      <h2 class="text-ink text-xl font-bold">The facts</h2>
      <dl class="mt-5 grid gap-x-8 gap-y-4 text-sm md:grid-cols-2">
        {
          facts.map(({ term, detail }) => (
            <div>
              <dt class="text-ink font-semibold">{term}</dt>
              <dd class="text-ink-muted mt-1 leading-relaxed">{detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <!-- Safety -->
  <Section class="!pt-0">
    <div
      class="border-primary/30 bg-primary-tint flex items-start gap-4 rounded-2xl border p-6 md:p-8"
    >
      <svg
        class="text-primary mt-0.5 h-6 w-6 flex-shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-4"></path>
      </svg>
      <div>
        <p class="text-ink font-semibold">Your doctor sets the plan, and the app helps you keep to it.</p>
        <p class="text-ink-muted mt-1 text-sm leading-relaxed text-pretty">
          This app does not calculate or recommend insulin doses. All dosing decisions are made
          exclusively by your licensed physician. The app is a record-keeping and communication tool
          only.
        </p>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section class="!pt-0">
    <FAQ faqs={faqs} lede="Something else on your mind? Write to us and we will answer properly." />
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="Join the patient waitlist"
      body="We'll let you know when The Diabetes App is ready for you. We only ask how to reach you."
      ctaLabel="Join the waitlist"
      href={FORMS.waitlist}
      secondaryLabel="See the clinic side"
      secondaryHref="/clinic-app"
    />
  </Section>
</Base>
