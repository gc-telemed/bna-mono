---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { NAV } from '@/data/site';
---

<Base title="Page not found" description="That page does not exist." path="/404">
  <Section class="!py-24 lg:!py-32">
    <div class="mx-auto max-w-lg text-center">
      <p class="text-primary text-6xl font-bold tabular-nums">404</p>
      <h1 class="text-ink mt-4 text-3xl font-bold tracking-tight">That page does not exist</h1>
      <p class="text-ink-muted mt-3 text-pretty">
        The link may be out of date, or we may have moved something. Here is everything else.
      </p>
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-2.5">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="hover:border-primary/30 hover:text-primary border-line-strong bg-surface text-ink inline-flex rounded-lg border px-4 py-2 text-sm font-medium transition"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/"
        class="bg-primary hover:bg-primary-pressed text-on-fill mt-8 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition"
      >
        Back to the homepage
      </a>
    </div>
  </Section>
</Base>
