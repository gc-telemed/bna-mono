---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { NAV } from '@/data/site';
---

<Base title="Page not found" description="That page does not exist." path="/404">
  <Section class="!py-24 lg:!py-32">
    <div class="mx-auto max-w-lg text-center">
      <p class="text-brand-500 dark:text-brand-400 text-6xl font-bold tabular-nums">404</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">
        That page does not exist
      </h1>
      <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
        The link may be out of date, or we may have moved something. Here is everything else.
      </p>
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-2.5">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="hover:border-brand-300 hover:text-brand-700 dark:hover:border-brand-400/40 dark:hover:text-brand-300 inline-flex rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/"
        class="bg-brand-600 hover:bg-brand-700 mt-8 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold text-white shadow-sm transition"
      >
        Back to the homepage
      </a>
    </div>
  </Section>
</Base>
