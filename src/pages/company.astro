---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/CTA.astro';
import NameBand from '@/components/NameBand.astro';
import LineOut from '@/components/LineOut.astro';
import { CONTACT, PRODUCTS, FORMS, NAMES, OFFERS, THREADS } from '@/data/site';

// v5.1. needs_review: Nepali versions of every block below, reviewed by a native speaker.
const page = {
  description:
    'About cosys.work: who we are, what we hold to, and how we keep data, models and running costs under the owner’s control.',
  lede: 'cosys.work builds collaborative systems that people own. They run on the devices people already have, keep working offline, and sync directly between the people who share them. We started with chronic care, because the tools available asked for a permanent internet connection, a monthly fee, and an unconditional copy of the most private thing a person has.',
};

const technology = {
  eyebrow: 'Technology in Nepal',
  title: 'Kept at home,',
  accentTitle: 'open to the world on purpose',
  lede: 'Most software used in Nepal keeps its data on servers abroad, sends its questions to foreign AI services, and stops when the line drops. We build our products and our clients’ systems so the data, the models and the bills stay under the owner’s control.',
  jumpLabel: 'Jump to a thread',
  exampleLabel: 'For example:',
};

// One block per thread, keyed by its id in THREADS (site.ts), which sets the anchor and the
// jump link's label.
const threads: Record<
  (typeof THREADS)[number]['id'],
  { title: string; body: string[]; list: string[]; example: string }
> = {
  sovereignty: {
    title: 'Data stays with the people and offices it belongs to',
    body: [
      'A patient’s record lives on their phone and at their clinic. A company’s record lives on its own laptops and office box. Each keeps the keys to its own copy, and an outside party such as an auditor, a bank or a regulator gets a signed view of exactly the part it needs, which can be withdrawn later.',
      'For public services we propose the same rule at national scale, as federated data residency. Records stay with the province or office that owns them, and questions travel between offices while the records stay put.',
    ],
    list: [
      'Each business names one key holder, usually the owner or the treasurer. The key is made on the business’s own device, and we never hold a copy.',
      // The two providers are not named until the founder decides (open item).
      'Where we host, we use data centre and cloud providers listed with Nepal’s Department of Information Technology, starting with two and adding the rest of the list over time.',
    ],
    example:
      'a clinic’s records stay on its own machines. We don’t hold a copy, so we are never a third party to its record-keeping.',
  },
  ai: {
    title: 'Local models first, large models on your terms',
    body: [
      'Most AI integrations send a company’s cleaned records, prices, supplier terms and its questions to a model abroad, one convenient call at a time. The company keeps a chat box and a bill that grows with use, and some of its know-how leaves with every call. We keep the intelligence close: a small model on each phone and laptop, and a larger one on the office or branch box, working on data that stays in the building.',
      'Our local models are built on Gemma, chosen after we examined the open models available. We improve them with fine-tuning, distillation and further pre-training, and we are extending them to long-running tasks, to several agents and several users working together, to step-by-step reasoning, and to larger training data.',
    ],
    list: [
      'A question too large for local machines can go to a large model abroad, one call at a time. Every such call is deliberate, logged, kept to the minimum and reversible.',
      // "Local body" reading awaits the founder (open item); the egress templates get a link once published.
      'Each organisation, and each local body that runs public services, sets its own policy for what may leave. We provide base templates and guidelines to start from.',
    ],
    example:
      'the Diabetes App reads a glucometer photo on the phone itself, so the picture never leaves it.',
  },
  resilience: {
    title: 'Work carries on when the line drops',
    body: [
      'In many parts of Nepal the line drops every day, and a power cut can take a whole office offline. Our systems keep every essential task on the devices people hold. Devices sync directly when they can reach each other, through a relay when they cannot, and wait when there is no connection at all. When the line returns, the copies merge and every entry keeps its author’s signature.',
    ],
    list: [
      'Relays carry sealed messages they cannot read, and anyone can run one.',
      'The network depends on no single operator, ourselves included.',
    ],
    example:
      'a branch with a bad line keeps approving leave and answering questions, and its records join the rest of the company when the line comes back.',
  },
  intelligence: {
    title: 'Business intelligence from your own record',
    body: [
      'An organisation’s intelligence is the record of how it works: who decided what, who approved it, who was waiting and for how long. Kept at home, that record feeds reports and answers built by models on your own machines, and each answer cites the entries it drew on. There is nothing to buy back from a vendor.',
    ],
    list: [
      'Each team’s assistant answers from what that team may see, because nothing else is on its machines.',
      'A view for an outside party keeps only the fields that party needs.',
    ],
    example:
      'an investor’s view can show how headcount moved last quarter without naming who was hired.',
  },
  costs: {
    title: 'Run it for less',
    body: [
      'Rented cloud and AI services charge more the more you use them. When the work runs on machines you own, with compute pooled between them peer to peer, the bill shrinks to the parts that still need a provider: relaying sealed messages, keeping encrypted backups, and the occasional large-model call.',
    ],
    list: [
      'Before a workload moves, we give a plain verdict: move it now, fix it first, or keep it rented for now.',
      'We measure the savings with each client as the work moves, and we don’t promise a figure in advance.',
    ],
    example:
      'a ward office and a ministry can draw on one shared pool of machines in the country, instead of each paying for a foreign service.',
  },
};

// Words inside the drawing in the Local AI first thread.
const lineOut = {
  title: 'One guarded line out',
  label:
    'On the left, local and small: a phone, a laptop and an office box, where data and models stay. One guarded line leads right, to a large model abroad. Every call along it is deliberate, logged, kept to the minimum and reversible. Each organisation decides what crosses.',
  local: {
    title: 'Local and small',
    chips: ['Phone', 'Laptop', 'Office box'],
    note: 'Data and models stay here',
  },
  gate: { label: 'One guarded line', tags: ['Deliberate', 'Logged', 'Minimal', 'Reversible'] },
  global: {
    title: 'Global and large',
    chips: ['Large model'],
    note: 'Gets only what you let through',
  },
  rule: 'Each organisation decides what crosses the line',
};

// New in v5. needs_review: Nepali versions, reviewed by a native speaker.
const workWithUs = {
  eyebrow: 'Work with us',
  title: 'Your own systems,',
  accentTitle: 'in production',
  lede: 'We also help companies, organisations and ministries move their systems onto machines they own. Everything in Technology in Nepal comes with both offers.',
  action: 'Write to us',
};

const beliefs = [
  {
    emoji: '🧭',
    title: 'The record belongs to the patient',
    body: 'Not to us, and not to whoever acquires us later. If a company can monetise a health history, sooner or later it is asked to. We removed the option by removing the copy.',
  },
  {
    emoji: '📡',
    title: 'Connectivity is a luxury, not a premise',
    body: 'Software that stops working when the signal drops is not a medical tool, it is a website. Everything essential runs on the device, and the network is a bonus.',
  },
  {
    emoji: '🩺',
    title: 'Clinicians decide, software remembers',
    body: 'No dose calculations and no automated diagnosis. We build record-keeping and communication, and the clinician makes the call.',
  },
  {
    emoji: '🫱',
    title: 'The people who live with it should steer it',
    body: 'Our diabetes trainers, one of whom lives with Type 1, shape what we build.',
  },
];

const approach = [
  {
    emoji: '🏔️',
    title: 'Start where the constraints are real',
    body: 'We build first for places with patchy bandwidth, expensive hardware and long journeys to clinics. Software that holds up there works comfortably everywhere else, and the reverse is almost never true.',
  },
  {
    emoji: '📷',
    title: 'Meet people at the hardware they own',
    body: 'Continuous monitors and connected devices are out of reach for most people with diabetes. So the camera is the sensor: photograph the meter you already have, and let the phone do the reading.',
  },
  {
    emoji: '🚪',
    title: 'Turn the journey around',
    body: 'Routine chronic care sends the patient to the clinic, the lab and the pharmacy. Where licensed local services can do it, we route the visit in the other direction instead.',
  },
  {
    emoji: '🔁',
    title: 'Generalise from one condition, carefully',
    body: 'Diabetes is where we start because the daily logging burden is severe and the clinical loop is tight. The same fabric extends to other long-term conditions once it is genuinely proven on one.',
  },
];
---

<Base title="Company" description={page.description} path="/company">
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="border-primary/30 bg-primary-tint text-ink inline-block rounded-full border px-4 py-1 text-sm font-medium"
      >
        About cosys.work
      </span>
      <h1
        class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:leading-tight"
      >
        We build the tools we{' '}<br class="hidden sm:block" />
        <span class="text-primary">wanted to exist</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        {page.lede}
      </p>
      <p class="text-ink mt-5 font-medium">
        Built in Nepal. The Diabetes App is in closed pilot and free forever.
      </p>
    </div>
  </Section>

  <!-- Story -->
  <Section>
    <div class="text-ink-muted mx-auto max-w-3xl space-y-5 text-lg leading-relaxed text-pretty">
      <p>
        Diabetes care is mostly logging. Readings, meals, doses and symptoms, recorded by hand
        several times a day, for the rest of someone&rsquo;s life. It is tedious enough that most
        people stop, and when the logging stops the clinician loses the only honest view of what is
        actually happening between appointments.
      </p>
      <p>
        The usual answer is more hardware and more cloud: a continuous monitor, a subscription, a
        dashboard hosted somewhere far away. That answer excludes most of the people who need it
        most, and it quietly assumes that a company should hold everybody&rsquo;s medical history in
        one place.
      </p>
      <p class="text-ink font-medium">
        We took a different route. Use the camera people already own. Run the intelligence on the
        phone. Move records directly between the patient and the people who need them, and let
        nothing in the middle read them.
      </p>
      <p>
        That turned out to require three things rather than one: an app for the patient, an app for
        the clinic, and a peer-to-peer network connecting them. The patient app and the network come
        first; the Clinic App is in development.
      </p>
    </div>
  </Section>

  <!-- What we believe -->
  <Section class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow="What we hold to"
        title="Four commitments that make"
        accentTitle="the rest of it harder"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {beliefs.map((item) => <Card {...item} />)}
      </div>
    </div>
  </Section>

  <!-- How we work -->
  <Section>
    <SectionHeading
      eyebrow="How we work"
      title="Built for the hard case first,"
      accentTitle="not retrofitted to it"
      lede="We work out of Nepal, and we build for it before we build for anywhere else. That is a design constraint as much as a market."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {approach.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- Technology in Nepal -->
  <Section id="technology-in-nepal" class="scroll-mt-20 !pt-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow={technology.eyebrow}
        title={technology.title}
        accentTitle={technology.accentTitle}
        lede={technology.lede}
      />
      <nav aria-label={technology.jumpLabel} class="mt-8">
        <ul class="flex flex-wrap justify-center gap-2">
          {
            THREADS.map(({ id, label }) => (
              <li>
                <a
                  href={`#${id}`}
                  class="border-line-strong bg-surface text-ink hover:border-primary inline-block rounded-full border px-4 py-1.5 text-sm font-semibold transition"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-12 grid gap-5">
        {
          THREADS.map(({ id, label }) => {
            const t = threads[id];
            return (
              <article
                id={id}
                class="reveal border-line bg-surface scroll-mt-20 rounded-2xl border p-5 sm:p-8 lg:p-10"
              >
                <div class="grid gap-6 lg:grid-cols-2 lg:gap-12">
                  <div>
                    <p class="text-ink-muted text-xs font-semibold tracking-wider uppercase">
                      {label}
                    </p>
                    <h3 class="text-ink mt-2 text-xl font-bold text-pretty md:text-2xl">
                      {t.title}
                    </h3>
                    <div class="text-ink-muted mt-4 space-y-4 leading-relaxed text-pretty">
                      {t.body.map((line) => (
                        <p>{line}</p>
                      ))}
                    </div>
                  </div>
                  {id === 'ai' && (
                    <div class="-mx-5 sm:mx-0 lg:col-span-2 lg:row-start-2">
                      <LineOut {...lineOut} />
                    </div>
                  )}
                  <div class="lg:col-start-2 lg:row-start-1">
                    <ul class="text-ink-muted list-disc space-y-3 pl-5 text-sm leading-relaxed">
                      {t.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    <p class="border-primary/30 bg-primary-tint text-ink mt-6 rounded-2xl border px-5 py-4 text-sm leading-relaxed">
                      <span class="font-semibold">{technology.exampleLabel}</span> {t.example}
                    </p>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </Section>

  <!-- Our names -->
  <Section class="!pt-0">
    <NameBand names={NAMES} title="Our names" compact />
  </Section>

  <!-- Work with us -->
  <Section id="work-with-us" class="scroll-mt-20 !py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow={workWithUs.eyebrow}
        title={workWithUs.title}
        accentTitle={workWithUs.accentTitle}
        lede={workWithUs.lede}
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {OFFERS.map((item) => <Card {...item} />)}
      </div>
      <div class="mt-8 text-center">
        <a
          href={`mailto:${CONTACT.email}`}
          class="bg-primary hover:bg-primary-pressed text-on-fill inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          {workWithUs.action}
        </a>
      </div>
    </div>
  </Section>

  <!-- Products recap -->
  <Section>
    <SectionHeading title="What we make" lede="Our products, and the network under them." />
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        PRODUCTS.map(({ slug, name, summary, emoji }) => (
          <a
            href={slug}
            class="lift reveal hover:border-primary/30 group border-line bg-surface rounded-2xl border p-7 transition hover:shadow-md focus-visible:shadow-md"
          >
            <span class="text-3xl" aria-hidden="true">
              {emoji}
            </span>
            <h3 class="text-ink mt-3 font-bold">{name}</h3>
            <p class="text-ink-muted mt-2 text-sm leading-relaxed">{summary}</p>
            <span class="text-primary mt-4 inline-flex items-center gap-1.5 text-sm font-semibold">
              Learn more
              <svg
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="Work with us"
      body="Clinics willing to shape the workflow, people living with diabetes who have strong opinions, and developers who want to build on a peer-to-peer network are all welcome."
      ctaLabel="Bring your clinic"
      href={FORMS.clinic}
      secondaryLabel="Contact details"
      secondaryHref="/contact"
    />
  </Section>
</Base>
