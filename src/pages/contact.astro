---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { SITE, CONTACT } from '@/data/site';

const routes = [
  {
    emoji: '🩸',
    title: 'Living with diabetes',
    body: 'Feature wishlists, workflows that would actually fit your life, and what other apps got wrong. This is the input we want most.',
    label: CONTACT.productEmail,
    href: `mailto:${CONTACT.productEmail}`,
  },
  {
    emoji: '🩺',
    title: 'Clinics and clinicians',
    body: 'Walkthroughs, pilots, and shaping the consultation workflow around how your practice actually runs.',
    label: CONTACT.clinicEmail,
    href: `mailto:${CONTACT.clinicEmail}`,
  },
  {
    emoji: '🧩',
    title: 'Developers and partners',
    body: 'Building a plugin, integrating a service, or wanting to pick apart the architecture. Also where press enquiries land.',
    label: CONTACT.email,
    href: `mailto:${CONTACT.email}`,
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---

<Base
  title="Contact"
  description={`Get in touch with ${SITE.name} about the Diabetes App, the Clinic App, or building on the peer-to-peer platform.`}
  path="/contact"
  structuredData={structuredData}
>
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="border-brand-300 bg-brand-50 text-brand-700 dark:border-brand-400/30 dark:bg-brand-400/10 dark:text-brand-300 inline-block rounded-full border px-4 py-1 text-sm font-medium"
      >
        Contact
      </span>
      <h1
        class="mt-6 text-4xl font-bold tracking-tight text-balance text-neutral-900 sm:text-5xl lg:leading-tight dark:text-white"
      >
        Tell us what you need{' '}<br class="hidden sm:block" />
        <span class="text-brand-600 dark:text-brand-400">this to do</span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400"
      >
        We are in the phase where feedback changes the product rather than gets filed. Pick
        whichever address fits and write properly — we read all of it.
      </p>
    </div>
  </Section>

  <Section class="!pt-4">
    <div class="grid gap-5 md:grid-cols-3">
      {
        routes.map(({ emoji, title, body, label, href }) => (
          <a
            href={href}
            class="hover:border-brand-300 dark:hover:border-brand-400/40 group flex flex-col rounded-2xl border border-neutral-200 bg-white p-7 transition hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900"
          >
            <span class="text-3xl" aria-hidden="true">
              {emoji}
            </span>
            <h2 class="mt-3 font-bold text-neutral-900 dark:text-neutral-100">{title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              {body}
            </p>
            <span class="text-brand-600 dark:text-brand-400 mt-5 inline-flex items-center gap-1.5 text-sm font-semibold break-all">
              {label}
              <svg
                class="h-4 w-4 flex-shrink-0 transition group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="mt-10 rounded-2xl border border-neutral-200 bg-neutral-50 p-7 dark:border-neutral-800 dark:bg-neutral-900"
    >
      <h2 class="font-semibold text-neutral-900 dark:text-neutral-100">Where we are</h2>
      <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        {CONTACT.locations}. We work remotely and asynchronously, so email reaches us faster than
        anything else.
      </p>
    </div>
  </Section>
</Base>
