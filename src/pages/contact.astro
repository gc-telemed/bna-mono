---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import InterestForm from '@/components/InterestForm.astro';
import { SITE, CONTACT } from '@/data/site';

const addresses = [
  { title: 'The Diabetes App', label: CONTACT.productEmail },
  { title: 'Clinics and clinicians', label: CONTACT.clinicEmail },
  { title: 'Plugins, partners and press', label: CONTACT.email },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---

<Base
  title="Contact"
  description={`Join the waitlist for The Diabetes App, bring your clinic to the Clinic App, or write to ${SITE.name}.`}
  path="/contact"
  structuredData={structuredData}
>
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="border-primary/30 bg-primary-tint text-ink inline-block rounded-full border px-4 py-1 text-sm font-medium"
      >
        Contact
      </span>
      <h1
        class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:leading-tight"
      >
        Built in Nepal,{' '}<br class="hidden sm:block" />
        <span class="text-primary">for care between visits</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        Patients: The Diabetes App is in closed pilot, so join the waitlist and we&rsquo;ll tell you
        when it is ready for you. Clinics: the Clinic App is in development, and we&rsquo;ll arrange
        a preview.
      </p>
    </div>
  </Section>

  <Section class="!pt-4">
    <div class="grid gap-5 md:grid-cols-2 md:items-start">
      <InterestForm kind="waitlist" />
      <InterestForm kind="clinic" />
    </div>

    <div class="border-line bg-surface-muted mt-10 rounded-2xl border p-7">
      <h2 class="text-ink font-semibold">Or write to us</h2>
      <ul class="mt-3 grid gap-3 text-sm sm:grid-cols-3">
        {
          addresses.map(({ title, label }) => (
            <li>
              <p class="text-ink-muted">{title}</p>
              <a
                href={`mailto:${label}`}
                class="text-primary font-medium break-all underline-offset-2 hover:underline"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-ink-muted mt-4 text-sm">{CONTACT.locations}</p>
    </div>
  </Section>
</Base>
