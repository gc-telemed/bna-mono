---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { SITE, CONTACT, PRODUCTS } from '@/data/site';

const product = PRODUCTS[2]!;
const accent = 'text-primary';
const chip = 'border-primary/30 bg-primary-tint text-ink';

const comparison = [
  {
    dimension: 'Where records live',
    cloud: 'Centralised corporate servers and data lakes',
    cosys: 'On the patient’s phone, and with the people and clinics they choose to share with',
  },
  {
    dimension: 'Dependency',
    cloud: 'Continuous bandwidth; degrades or fails in dead zones',
    cosys: 'Offline-first throughout, syncing asynchronously when a connection appears',
  },
  {
    dimension: 'Risk profile',
    cloud: 'Systemic: one breach exposes an entire population',
    cosys: 'Fragmented: compromising the network means compromising devices one at a time',
  },
  {
    dimension: 'Custody',
    cloud: 'The operator holds raw records, and answers for them',
    cosys: 'No readable operator copy: anything a server holds on the way is sealed',
  },
  {
    dimension: 'Extension',
    cloud: 'A single vendor roadmap and an approval queue',
    cosys: 'Planned: plugins published directly to the people who want them',
  },
];

const layers = [
  {
    emoji: '📱',
    title: 'The device layer',
    body: 'Every participant holds their own records locally. Applications are fully functional on the device alone; the network is an addition to that, never a prerequisite for it.',
  },
  {
    emoji: '🔗',
    title: 'The trust fabric',
    body: 'Devices connect only to peers the owner has verified: a family member, a carer, and later a clinic. Each link is granted deliberately and can be ended the same way.',
  },
  {
    emoji: '🏛️',
    title: 'Institutional nodes',
    body: 'Coming with the Clinic App: each clinic holds a key of its own, listed in a signed directory, and keeps each patient’s record sealed under a key only it holds.',
  },
  {
    emoji: '🧩',
    title: 'The plugin fabric',
    body: 'Planned: the same network will distribute extensions from dietitians, coaches, researchers and clinics, and people will install only what they want.',
  },
];

const sovereignty = [
  {
    emoji: '🗑️',
    title: 'Erasure that actually erases',
    body: 'Ending a share can also ask the other side to erase what it received, and a clinic answers with a receipt. There is no operator archive quietly keeping a readable copy.',
  },
  {
    emoji: '📚',
    title: 'Clinics keep their obligations intact',
    body: 'Institutional nodes retain the durable clinical record their own regulators require, on their own infrastructure, without that record being pooled with anyone else’s.',
  },
  {
    emoji: '🧊',
    title: 'Encrypted backup, kept by you',
    body: 'A backup is a file only the owner’s passphrase opens, kept wherever they choose. There is no cloud copy to fall back on, so the backup is the copy.',
  },
  {
    emoji: '🍴',
    title: 'What leaves is decided on the phone',
    body: 'A family member on Range only receives words like “below” or “in range” and never a number, because the number is removed before anything is sealed.',
  },
];

const faqs = [
  {
    question: 'What does peer-to-peer mean in practice here?',
    answer:
      'Records move directly between the devices that need them, over encrypted connections the owner has authorised, using iroh, an open-source peer-to-peer library. A relay helps two phones find each other when they cannot connect directly. It passes on sealed traffic and cannot read it.',
  },
  {
    question: 'Is there a server at all?',
    answer:
      'Yes, three small ones, and none of them can read a record. A relay helps phones connect. A mailbox holds sealed envelopes for a phone that is offline, until it collects them. And a wake-up service tells a phone that something is waiting, with a message that carries nothing: no reading, no name, not even who sent it.',
  },
  {
    question: 'How will a clinic get my history?',
    answer:
      'With the Clinic App, which is coming soon: you scan your clinic’s QR code and choose to share. Your history travels over the encrypted connection, and the clinic keeps what you shared, sealed under its own key.',
  },
  {
    question: 'What happens if I lose my phone?',
    answer:
      'Your record is on your phone and in any encrypted backup you made. A backup opens only with your passphrase, and restoring it on a new phone brings your record back. Keep the backup somewhere safe, because there is no cloud copy to fall back on.',
  },
  {
    question: 'How do I know a clinic is really my clinic?',
    answer:
      'Each clinic will be listed in a signed directory with its name, registration and key, so the app can check that the clinic you pair with is the one you walked into. A person is checked differently, by a short code you read aloud to each other.',
  },
  {
    question: 'Who decides what plugins are allowed?',
    answer:
      'Plugins are planned, not built. The intent is that they travel over the same network, straight to the people who want them. Get in touch if you would like to be an early builder.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: product.name,
  description: product.summary,
  url: `${SITE.url}${product.slug}`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---

<Base
  title={product.name}
  description={product.summary}
  path={product.slug}
  structuredData={structuredData}
>
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span class:list={['inline-block rounded-full border px-4 py-1 text-sm font-medium', chip]}>
        {product.audience}
      </span>
      <h1
        class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-tight"
      >
        No server that can{' '}<br class="hidden sm:block" />
        <span class={accent}>read your record</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        Both apps run on the same peer-to-peer network. Records move directly between the devices
        that need them, over connections their owner granted. When a device is offline, the update
        waits in a mailbox as a sealed envelope. We could not hand over a database of patient
        histories if we wanted to, because we do not have one.
      </p>
    </div>
  </Section>

  <!-- Layers -->
  <Section>
    <SectionHeading
      eyebrow="How it is put together"
      title="Four layers,"
      accentTitle="no centre"
      accentClass={accent}
      chipClass={chip}
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {layers.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- How the network works -->
  <Section class="!pt-0">
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <SectionHeading
          eyebrow="How the network works"
          title="Direct when it can be,"
          accentTitle="sealed when it can't"
          accentClass={accent}
          chipClass={chip}
          align="left"
        />
        <div class="text-ink-muted mt-5 space-y-4 leading-relaxed text-pretty">
          <p>
            Every phone and every clinic has its own key, made on the device. Phones talk to each
            other directly when they can, over
            <a
              href="https://github.com/n0-computer/iroh"
              class="text-primary font-medium underline-offset-2 hover:underline">iroh</a
            >, an open-source peer-to-peer library, with a relay for when they can&rsquo;t reach each
            other.
          </p>
          <p>
            When the other phone is offline, the update waits in a mailbox. The mailbox holds only
            sealed envelopes, and it can&rsquo;t read what&rsquo;s inside. When an alert is waiting,
            the emergency contact&rsquo;s phone gets a wake-up signal that carries no content at all,
            not even who sent it.
          </p>
          <p class="text-ink font-medium">
            What leaves a phone is decided on the phone. A family member on <em>Range only</em>
            receives words like &ldquo;below&rdquo; or &ldquo;in range&rdquo; and never a number,
            because the number is removed before anything is sealed.
          </p>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            { emoji: '📱', title: 'Patient phone', body: 'Holds the record. Decides what each person sees.' },
            { emoji: '👪', title: 'Family phones', body: 'Receive only the level the patient chose for them.' },
            { emoji: '📮', title: 'Sealed mailbox', body: 'Keeps envelopes for an offline phone. Cannot open them.' },
            { emoji: '🔁', title: 'Relay', body: 'Helps two phones connect. Passes on traffic it cannot read.' },
          ].map((item) => <Card {...item} />)
        }
      </div>
    </div>
  </Section>

  <!-- Comparison table -->
  <Section class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow="The trade"
        title="What changes when you"
        accentTitle="remove the middle"
        accentClass={accent}
        chipClass={chip}
      />

      <div class="border-line bg-surface mt-12 overflow-hidden rounded-2xl border">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">
            Centralised health platforms compared with the cosys.work peer-to-peer platform
          </caption>
          <thead>
            <tr class="border-line border-b">
              <th scope="col" class="text-ink px-5 py-4 font-semibold">
                <span class="sr-only">Dimension</span>
              </th>
              <th scope="col" class="text-ink-muted px-5 py-4 font-semibold">
                Centralised platforms
              </th>
              <th scope="col" class="text-primary px-5 py-4 font-semibold">
                The cosys.work platform
              </th>
            </tr>
          </thead>
          <tbody class="divide-line divide-y">
            {
              comparison.map(({ dimension, cloud, cosys }) => (
                <tr>
                  <th scope="row" class="text-ink px-5 py-4 align-top font-semibold">
                    {dimension}
                  </th>
                  <td class="text-ink-muted px-5 py-4 align-top">{cloud}</td>
                  <td class="text-ink px-5 py-4 align-top">{cosys}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Sovereignty -->
  <Section>
    <SectionHeading
      eyebrow="Data sovereignty"
      title="One architecture that satisfies"
      accentTitle="two contradictory instincts"
      accentClass={accent}
      chipClass={chip}
      lede="Patients want the right to erase their history. Clinical practice requires a durable record. Those pull against each other only while a single company holds one readable copy for everybody, so we removed that copy."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {sovereignty.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- Marketplace -->
  <Section>
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <SectionHeading
          eyebrow="Plugin marketplace"
          title="A health operating system,"
          accentTitle="extended by outsiders"
          accentClass={accent}
          chipClass={chip}
          align="left"
        />
        <div class="text-ink-muted mt-5 space-y-4 leading-relaxed text-pretty">
          <p>
            A person managing several overlapping conditions does not need one vendor&rsquo;s idea
            of what matters. They need the specific modules their own health calls for, and the
            people best placed to build those are usually not us.
          </p>
          <p>
            Plugins are planned, not built. The idea: a dietitian ships an on-device knowledge base,
            a clinic publishes something for its own patients, a coach builds for one sport, and
            each travels over the same peer-to-peer network, straight to the people who asked for
            it.
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            {
              emoji: '👩‍⚕️',
              title: 'Clinics',
              body: 'Publish a module built for the way your own practice follows up.',
            },
            {
              emoji: '🥗',
              title: 'Dietitians',
              body: 'Ship a scoring method that runs on the phone, with no connection needed.',
            },
            {
              emoji: '🏋️',
              title: 'Coaches',
              body: 'Build for one sport, one cohort, one very specific set of needs.',
            },
            {
              emoji: '🔬',
              title: 'Researchers',
              body: 'Offer instruments people can opt into, one category at a time.',
            },
          ].map((item) => <Card {...item} />)
        }
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section>
    <FAQ
      faqs={faqs}
      lede="The architecture raises reasonable questions. Here are the direct answers."
    />
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="Build on the fabric"
      body="If you are a developer, a clinic or a specialist who wants to publish something into this, or you simply want to argue with the architecture, we would like to hear from you."
      ctaLabel="Get in touch"
      email={CONTACT.email}
      secondaryLabel="About cosys.work"
      secondaryHref="/company"
    />
  </Section>
</Base>
