---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { SITE, PRODUCTS, FORMS } from '@/data/site';

const product = PRODUCTS[1]!;
const accent = 'text-primary';
const chip = 'border-primary/30 bg-primary-tint text-ink';

const beforeAfter = {
  before: [
    'An assistant retypes months of handwritten logs while the patient waits',
    'History arrives as a carrier bag of printouts, in no particular order',
    'A long wait collapses into a short consultation',
    'Follow-up instructions leave on paper and are never seen again',
    'Whether the plan was followed is a question, not a record',
  ],
  after: [
    'The history the patient chose to share is on screen before they sit down',
    'Readings, labs and medicines taken arrive already charted and ordered',
    'The appointment starts at the conversation, not the paperwork',
    'The plan you set appears on the patient’s phone, signed by you',
    'The next visit opens with what happened in between',
  ],
};

const capabilities = [
  {
    emoji: '⚡',
    title: 'Sync before the visit',
    body: 'The patient scans your clinic’s QR code, and an encrypted connection brings the history they choose to share to a tablet at your front desk. Each clinic is listed in a signed directory, so the patient knows the clinic they pair with is yours.',
  },
  {
    emoji: '📄',
    title: 'A one-page summary',
    body: 'Readings in range, readings under the low lines, medicines taken, latest labs, blood pressure and weight, and the patient’s own questions. It’s laid out to read in under a minute.',
  },
  {
    emoji: '🎯',
    title: 'Set the plan',
    body: 'Set glucose targets for each patient, starting from WHO values. Record medicines and doses as prescribed. The plan card on the patient’s phone shows it as set by your clinic, signed by the clinician, with every earlier version kept.',
  },
  {
    emoji: '📝',
    title: 'Make-a-note',
    body: 'Attach observations to specific readings, and build a record that stays with the patient.',
  },
  {
    emoji: '✅',
    title: 'Action checklists',
    body: 'Tests and follow-ups appear as items on the patient’s phone, with a printable version. Each item can link to a lab or pharmacy your clinic chooses. The patient approves every step.',
  },
  {
    emoji: '👁️',
    title: 'Close-watch patients',
    body: 'Ask a patient to add your clinic to their alerts. Only the patient can turn it on. Their alerts then appear on your “needs attention” list.',
  },
  {
    emoji: '📨',
    title: 'Visit summaries without paper',
    body: 'The patient’s summary PDF arrives in your records with the rest of their shared history.',
  },
  {
    emoji: '💬',
    title: 'Messages, if both sides want them',
    body: 'A thread for non-urgent questions between visits. Your clinic turns it on first, and then each patient chooses whether to join. It is not for emergencies.',
  },
];

const pricing = [
  { title: 'Free', body: 'During the preview.' },
  { title: 'Free', body: 'For up to 10 active patients.' },
  { title: 'Rs 5,000–10,000 a month', body: 'After that, depending on clinic size.' },
];

const faqs = [
  {
    question: 'When can we use it?',
    answer:
      'The Clinic App is in development, and a preview is available on request. The patient side of its protocol is already built into The Diabetes App, so the clinic side is being built against something fixed.',
  },
  {
    question: 'Where is patient data stored?',
    answer:
      'On the patient’s phone, and in your clinic’s records once they have shared it with you. Your records are written only by your clinic’s own device. Where they are stored on a server, each patient’s record is sealed with a key your clinic holds, so we cannot read it.',
  },
  {
    question: 'Does it replace our existing records system?',
    answer:
      'No. It sits alongside what you already use. It solves the intake problem, getting a patient’s structured history in front of you at the start of a consultation, rather than trying to be your system of record.',
  },
  {
    question: 'What if the clinic’s connection is down?',
    answer:
      'The patient’s phone and your clinic’s device connect directly when they are in the same room, so a visit does not depend on either side having good internet at that moment. Anything that needs the wider network waits and is sent when a connection returns.',
  },
  {
    question: 'Can we see whether patients followed the plan?',
    answer:
      'You see what they logged and chose to share, including time-stamped medicine records, with the gaps left as gaps. The point is an accurate picture, not a compliance score.',
  },
  {
    question: 'Does the app make clinical recommendations?',
    answer:
      'No. It does not calculate doses, propose diagnoses or rank patients. It structures and summarises what was recorded. Every clinical judgement remains yours.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  description: product.summary,
  url: `${SITE.url}${product.slug}`,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<Base
  title={product.name}
  description={product.summary}
  path={product.slug}
  structuredData={structuredData}
>
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span class:list={['inline-block rounded-full border px-4 py-1 text-sm font-medium', chip]}>
        {product.audience}
      </span>
      <h1
        class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-tight"
      >
        Spend the appointment{' '}<br class="hidden sm:block" />
        <span class={accent}>on the patient</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        The consultation is short because everything before it is slow. With the Clinic App, a
        patient&rsquo;s last month will be on your screen before they sit down.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={FORMS.clinic}
          class="bg-primary text-on-fill hover:bg-primary-pressed inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          Request a preview
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="#capabilities"
          class="border-line-strong bg-surface text-ink hover:bg-surface-muted inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          What it will do
        </a>
      </div>
      <p class="text-ink-muted mt-5 text-sm">
        In development. Preview available on request. Our target: halve intake time.{' '}
        <em>(A target, not yet a result.)</em>
      </p>
    </div>
  </Section>

  <!-- Before / after -->
  <Section>
    <SectionHeading
      eyebrow="The intake problem"
      title="The consultation is short because"
      accentTitle="everything before it is slow"
      accentClass={accent}
      chipClass={chip}
      lede="Almost none of the waiting is clinical. It is paperwork being moved from one format into another, by hand, while someone sits outside."
    />

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <div class="border-line bg-surface-muted rounded-2xl border p-8">
        <p class="text-ink-muted mb-5 text-xs font-semibold tracking-wider uppercase">
          A typical visit today
        </p>
        <ul class="space-y-3.5">
          {
            beforeAfter.before.map((item) => (
              <li class="text-ink-muted flex items-start gap-3 text-sm">
                <svg
                  class="text-danger mt-0.5 h-4.5 w-4.5 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <>
                    <circle cx="12" cy="12" r="10" />
                    <path d="m15 9-6 6M9 9l6 6" />
                  </>
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-primary/30 bg-primary-tint rounded-2xl border p-8">
        <p class="text-primary mb-5 text-xs font-semibold tracking-wider uppercase">
          With the Clinic App
        </p>
        <ul class="space-y-3.5">
          {
            beforeAfter.after.map((item) => (
              <li class="text-ink flex items-start gap-3 text-sm">
                <svg
                  class="text-primary mt-0.5 h-4.5 w-4.5 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Capabilities -->
  <Section id="capabilities" class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow="What it will do"
        title="A companion for the consultation,"
        accentTitle="not another system of record"
        accentClass={accent}
        chipClass={chip}
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => <Card {...item} />)}
      </div>
    </div>
  </Section>

  <!-- Liability -->
  <Section>
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <SectionHeading
          eyebrow="Governance"
          title="We are not in your"
          accentTitle="chain of custody"
          accentClass={accent}
          chipClass={chip}
          align="left"
        />
        <div class="text-ink-muted mt-5 space-y-4 leading-relaxed text-pretty">
          <p>
            Your clinic&rsquo;s records are written only by your clinic&rsquo;s own device. Where
            they&rsquo;re stored on a server, each patient&rsquo;s record is sealed with a key held by
            your clinic, so we can&rsquo;t read it. Patients hold their own record on their own phone.
          </p>
          <p>
            The patient can end the share at any time, and can ask for their record to be erased,
            with a receipt.
          </p>
          <p class="text-ink font-medium">
            The Clinic App is designed to support the Nepal Medical Council&rsquo;s telemedicine
            guidelines: consent, audit trail and encrypted records.
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            {
              emoji: '🔐',
              title: 'A key of its own',
              body: 'Your clinic’s identity is a key made on your clinic’s device, listed in a signed directory patients can check.',
            },
            {
              emoji: '📦',
              title: 'Sealed per patient',
              body: 'Each patient’s record is sealed under its own key, wrapped by your clinic’s key.',
            },
            {
              emoji: '🚫',
              title: 'Nothing we can read',
              body: 'We do not pool clinical records, and what a server holds for you is sealed with your key.',
            },
            {
              emoji: '↔️',
              title: 'Explicit grants',
              body: 'Every connection is opened by the patient and can be revoked by them at any time.',
            },
          ].map((item) => <Card {...item} />)
        }
      </div>
    </div>
  </Section>

  <!-- Pricing -->
  <Section class="!pt-0">
    <SectionHeading eyebrow="Pricing" title="Free to start," accentTitle="and free for small clinics" accentClass={accent} chipClass={chip} />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {pricing.map((item) => <Card {...item} />)}
    </div>
  </Section>

  <!-- FAQ -->
  <Section>
    <FAQ faqs={faqs} lede="Questions about fit, governance or onboarding? Ask us directly." />
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="Bring your clinic"
      body="Early practices shape how this works. If you run a chronic care clinic and want the intake problem gone, request a preview and we will build the workflow around how you actually operate."
      ctaLabel="Request a preview"
      href={FORMS.clinic}
      secondaryLabel="See the patient side"
      secondaryHref="/diabetes-app"
    />
  </Section>
</Base>
