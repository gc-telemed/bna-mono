---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Card from '@/components/Card.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { SITE, CONTACT, PRODUCTS } from '@/data/site';

const product = PRODUCTS[1]!;
const accent = 'text-primary';
const chip = 'border-primary/30 bg-primary-tint text-ink';

const beforeAfter = {
  before: [
    'An assistant retypes months of handwritten logs while the patient waits',
    'History arrives as a carrier bag of printouts, in no particular order',
    'A long wait collapses into a short consultation',
    'Follow-up instructions leave on paper and are never seen again',
    'Whether the plan was followed is a question, not a record',
  ],
  after: [
    'Structured history is on screen before the patient sits down',
    'Readings, labs and adherence arrive already charted and ordered',
    'The appointment starts at interpretation, not transcription',
    'The plan is pushed to the patient’s phone as a structured summary',
    'Next visit opens with what actually happened in between',
  ],
};

const capabilities = [
  {
    emoji: '⚡',
    title: 'Sync before the visit',
    body: 'The patient approves a direct, encrypted connection — typically by scanning a code at reception. Their longitudinal data populates your dashboard immediately.',
  },
  {
    emoji: '📝',
    title: 'Make-a-note',
    body: 'Attach an observation to the exact reading that prompted it. A recurring afternoon low gets a note in place, building a living record instead of a pile of separate documents.',
  },
  {
    emoji: '📈',
    title: 'Trends, pre-computed',
    body: 'Glucose against meals, activity and medication, with the patterns already surfaced. You start from the interpretation rather than from the arithmetic.',
  },
  {
    emoji: '✅',
    title: 'Action checklists',
    body: 'Set the labs, refills and lifestyle goals due before the next visit. They appear on the patient’s phone as concrete, trackable tasks rather than remembered advice.',
  },
  {
    emoji: '📄',
    title: 'Structured summaries',
    body: 'Generate a clean visit summary and updated plan, pushed straight back to the patient over the encrypted connection. No email attachments, no shared spreadsheets.',
  },
  {
    emoji: '🏥',
    title: 'Records stay yours',
    body: 'Clinical data lives on your own containerised systems, under your existing governance. We do not hold a copy, so we are never a party to your record-keeping obligations.',
  },
];

const faqs = [
  {
    question: 'Where is patient data stored?',
    answer:
      'On the patient’s device, and on your clinic’s own systems once they have shared it with you. We do not run a central repository of clinical records, which means your records remain under your governance and we never become a custodian of them.',
  },
  {
    question: 'Does it replace our existing records system?',
    answer:
      'No. It is a companion tool that sits alongside what you already use. It solves the intake problem — getting a patient’s real, structured history in front of you at the start of a consultation — rather than trying to be your system of record.',
  },
  {
    question: 'What does onboarding a patient involve?',
    answer:
      'The patient installs the companion app and scans a code to establish a trusted connection with your clinic node. From then on their history syncs whenever they choose to share it, including ahead of remote consultations.',
  },
  {
    question: 'What if the clinic’s connection is down?',
    answer:
      'Syncing happens over a direct local connection between the patient’s device and the clinic node, so it does not depend on either party having good internet at that moment. Anything that needs the wider network is queued and sent when a connection returns.',
  },
  {
    question: 'Can we see whether patients followed the plan?',
    answer:
      'You see what they logged, including time-stamped medication records, with the honesty and the gaps intact. The point is an accurate picture, not a compliance score — and patients decide what they share with you.',
  },
  {
    question: 'Does the app make clinical recommendations?',
    answer:
      'No. It does not calculate doses, propose diagnoses or rank patients. The on-device AI structures and summarises what was recorded. Every clinical judgement remains yours.',
  },
  {
    question: 'How do we get started?',
    answer:
      'We are onboarding clinics now, working closely with early practices to shape the workflow around how they actually run. Get in touch and we will arrange a walkthrough.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  description: product.summary,
  url: `${SITE.url}${product.slug}`,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<Base
  title={product.name}
  description={product.summary}
  path={product.slug}
  structuredData={structuredData}
>
  <!-- Hero -->
  <Section class="!pt-16 !pb-8 lg:!pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <span class:list={['inline-block rounded-full border px-4 py-1 text-sm font-medium', chip]}>
        {product.audience}
      </span>
      <h1
        class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl lg:leading-tight"
      >
        Spend the appointment{' '}<br class="hidden sm:block" />
        <span class={accent}>on the patient</span>
      </h1>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty">
        Clinicians end up as data entry clerks: long waits for the patient, a handful of real
        minutes for the consultation. The Clinic App brings a structured history to your screen
        before the door opens, so the time you have goes on judgement instead of transcription.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${CONTACT.clinicEmail}`}
          class="bg-primary text-on-fill hover:bg-primary-pressed inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          Request a walkthrough
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="#capabilities"
          class="border-line-strong bg-surface text-ink hover:bg-surface-muted inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold shadow-sm transition"
        >
          What it does
        </a>
      </div>
    </div>
  </Section>

  <!-- Before / after -->
  <Section>
    <SectionHeading
      eyebrow="The intake problem"
      title="The consultation is short because"
      accentTitle="everything before it is slow"
      accentClass={accent}
      chipClass={chip}
      lede="Almost none of the waiting is clinical. It is paperwork being moved from one format into another, by hand, while someone sits outside."
    />

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <div class="border-line bg-surface-muted rounded-2xl border p-8">
        <p class="text-ink-muted mb-5 text-xs font-semibold tracking-wider uppercase">
          A typical visit today
        </p>
        <ul class="space-y-3.5">
          {
            beforeAfter.before.map((item) => (
              <li class="text-ink-muted flex items-start gap-3 text-sm">
                <svg
                  class="text-danger mt-0.5 h-4.5 w-4.5 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <>
                    <circle cx="12" cy="12" r="10" />
                    <path d="m15 9-6 6M9 9l6 6" />
                  </>
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-primary/30 bg-primary-tint rounded-2xl border p-8">
        <p class="text-primary mb-5 text-xs font-semibold tracking-wider uppercase">
          With the Clinic App
        </p>
        <ul class="space-y-3.5">
          {
            beforeAfter.after.map((item) => (
              <li class="text-ink flex items-start gap-3 text-sm">
                <svg
                  class="text-primary mt-0.5 h-4.5 w-4.5 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Capabilities -->
  <Section id="capabilities" class="!py-0">
    <div class="bg-surface-muted rounded-3xl px-6 py-14 sm:px-10 lg:px-16 lg:py-20">
      <SectionHeading
        eyebrow="Capabilities"
        title="A companion for the consultation,"
        accentTitle="not another system of record"
        accentClass={accent}
        chipClass={chip}
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => <Card {...item} />)}
      </div>
    </div>
  </Section>

  <!-- Liability -->
  <Section>
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <SectionHeading
          eyebrow="Governance"
          title="We are not in your"
          accentTitle="chain of custody"
          accentClass={accent}
          chipClass={chip}
          align="left"
        />
        <div class="text-ink-muted mt-5 space-y-4 leading-relaxed text-pretty">
          <p>
            Clinical records stay on your own encrypted, containerised systems, exactly where your
            existing obligations already expect them to be. Patients hold their own copy on their
            own device. There is no third location.
          </p>
          <p>
            Institutional connections are established with per-organisation certificates, so an
            exchange between a clinic, a laboratory and a patient is signed, verifiable and
            isolated. A partner node can see what it has been granted and nothing beyond it.
          </p>
          <p class="text-ink font-medium">
            Because we never hold raw records, adopting the Clinic App does not hand a new custodian
            a copy of your patients&rsquo; histories.
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            {
              emoji: '🔐',
              title: 'Per-organisation certificates',
              body: 'Each participating clinic or lab issues its own identities and transport certificates.',
            },
            {
              emoji: '📦',
              title: 'Containerised nodes',
              body: 'Your node runs in your environment, isolated from every other organisation on the network.',
            },
            {
              emoji: '🚫',
              title: 'No central copy',
              body: 'We do not aggregate clinical records, so there is no repository of ours to breach or subpoena.',
            },
            {
              emoji: '↔️',
              title: 'Explicit grants',
              body: 'Every connection is opened by the patient and can be revoked by them at any time.',
            },
          ].map((item) => <Card {...item} />)
        }
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section>
    <FAQ faqs={faqs} lede="Questions about fit, governance or onboarding? Ask us directly." />
  </Section>

  <!-- CTA -->
  <Section>
    <CTA
      title="We are onboarding clinics now"
      body="Early practices shape how this works. If you run a chronic care clinic and want the intake problem gone, we would like to build the workflow around how you actually operate."
      ctaLabel="Talk to us"
      email={CONTACT.clinicEmail}
      secondaryLabel="See the patient side"
      secondaryHref="/diabetes-app"
    />
  </Section>
</Base>
